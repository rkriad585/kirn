# stdlib/lib/collections_test.kn - tests for lib.collections.
import lib.collections;

def main() {
    m = collections.HashMap();
    m.put("a", 1);
    m.put("b", 2);
    assert_eq(m.get("a"), 1);
    assert_eq(m.get("b"), 2);
    assert(m.has("a"));
    assert(not m.has("z"));
    assert_eq(m.size(), 2);
    m.remove("a");
    assert(not m.has("a"));

    assert_eq(collections.join(["x", "y", "z"], "-"), "x-y-z");
    assert_eq(collections.join([], "+"), "");
    assert_eq(collections.split("a,b,c", ",").len(), 3);
    assert(collections.contains([1, 2, 3], 2));
    assert(not collections.contains([1, 2, 3], 9));
    assert_eq(collections.unique([1, 2, 2, 3, 3, 3]).len(), 3);

    print("collections_test ok");
}