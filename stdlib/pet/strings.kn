# stdlib/pet/strings.kn - string helpers (Kirn-written, Phase 6).
# Built on the runtime string builtins (upper/lower/trim/replace/split/...)
# plus additional Kirn-defined utilities. Import with: import pet.strings;

pub fn contains(s: Str, sub: Str) -> Bool {
    return s.contains(sub);
}

pub fn starts_with(s: Str, prefix: Str) -> Bool {
    return s.starts_with(prefix);
}

pub fn ends_with(s: Str, suffix: Str) -> Bool {
    return s.ends_with(suffix);
}

# Repeatedly replace all occurrences of `from` with `to`.
pub fn replace_all(s: Str, from: Str, to: Str) -> Str {
    return s.replace(from, to);
}

# Split into a list of parts; empty separators split per character.
pub fn split(s: Str, sep: Str) -> list {
    return s.split(sep);
}

# Join a list of strings with sep.
pub fn join(parts: list, sep: Str) -> Str {
    if parts.len() == 0 { return ""; }
    out = Str(parts[0]);
    i = 1;
    while i < parts.len() {
        out = out + sep + Str(parts[i]);
        i = i + 1;
    }
    return out;
}

# Repeat s n times (n <= 0 returns "").
pub fn repeat(s: Str, n: Int) -> Str {
    out = "";
    i = 0;
    while i < n {
        out = out + s;
        i = i + 1;
    }
    return out;
}

# Reverse a string (per code point).
pub fn reverse(s: Str) -> Str {
    return join(reversed(s.split("")), "");
}

# Left-pad s to at least `width` chars with `pad` (or a space).
pub fn pad_left(s: Str, width: Int, pad: Str) -> Str {
    p = pad;
    if p == "" { p = " "; }
    while s.len() < width {
        s = p + s;
    }
    return s;
}

# Right-pad s to at least `width` chars with `pad` (or a space).
pub fn pad_right(s: Str, width: Int, pad: Str) -> Str {
    p = pad;
    if p == "" { p = " "; }
    while s.len() < width {
        s = s + p;
    }
    return s;
}

# Strip chars in `set` from both ends (default: whitespace).
pub fn strip(s: Str) -> Str {
    return s.trim();
}