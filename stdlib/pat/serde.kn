# stdlib/pat/serde.kn — reflection-based serialization framework (POWER_PLAN §3).
#
# This is the "Tier-2 dynamic serde" path: it uses the `reflect` module to walk
# structs and enums structurally, so it works without `@[derive(...)]` codegen.
# The reusable pieces (tree encode + typed coercion) live in `pat.codec`; the
# JSON text layer lives in `pat.json`; this module is the user-facing pair.
#
#   import pat.serde as serde;
#   s = serde.to_json(user);
#   back = serde.from_json_as(User, s);
#
# Enum encoding is externally tagged with a single key: `{"Variant": payload}`
# where payload is `null` (unit variant) or a JSON array (all others).

import pat.codec as codec;
import pat.json as json;
import reflect;

# Format-neutral adapter contracts. Kirn's runtime represents serialized
# values as trees, so these adapters expose the same separation as serde's
# Serializer/Deserializer without requiring a format-specific implementation.
pub trait Encoder {
    fn write_bool(self, v: Bool) -> any;
    fn write_int(self, v: Int) -> any;
    fn write_float(self, v: Float) -> any;
    fn write_str(self, v: Str) -> any;
    fn write_nil(self) -> any;
    fn begin_seq(self, n: Int) -> any;
    fn begin_map(self, n: Int) -> any;
    fn begin_struct(self, name: Str, n: Int) -> any;
    fn begin_enum(self, name: Str, variant: Str, n: Int) -> any;
    fn write_key(self, key: Str) -> any;
    fn set_tree(self, tree: any) -> any;
    fn end(self) -> any;
    fn finish(self) -> any;
}

pub trait Decoder {
    fn read_any(self) -> any;
    fn read_bool(self) -> Bool;
    fn read_int(self) -> Int;
    fn read_float(self) -> Float;
    fn read_str(self) -> Str;
    fn field(self, key: Str) -> any;
    fn at(self, index: Int) -> any;
    fn len(self) -> Int;
    fn has_key(self, key: Str) -> Bool;
}

pub trait Visitor {
    fn visit(self, decoder: any) -> any;
}

fn tree_has_key(d: any, key: Str) -> Bool {
    for k in d { if k == key { return true; } }
    return false;
}

pub struct TreeEncoder {
    h: dict;

    fn put(self, v: any) -> none {
        if self.h["stack"].len() > 0 {
            parent = self.h["stack"][self.h["stack"].len() - 1];
            if reflect.kind_of(parent) == "list" {
                parent.append(v);
            } else if self.h["key"] != none {
                parent[self.h["key"]] = v;
                self.h["key"] = none;
            }
        } else if self.h["tree"] == none {
            self.h["tree"] = v;
        } else if reflect.kind_of(self.h["tree"]) == "list" {
            self.h["tree"].append(v);
        } else if self.h["key"] != none {
            self.h["tree"][self.h["key"]] = v;
            self.h["key"] = none;
        } else {
            self.h["tree"] = v;
        }
    }

    fn write_bool(self, v: Bool) -> any { self.put(v); return none; }
    fn write_int(self, v: Int) -> any { self.put(v); return none; }
    fn write_float(self, v: Float) -> any { self.put(v); return none; }
    fn write_str(self, v: Str) -> any { self.put(v); return none; }
    fn write_nil(self) -> any { self.put(none); return none; }
    fn begin_seq(self, n: Int) -> any {
        child = [];
        self.put(child);
        self.h["stack"].append(child);
        self.h["key"] = none;
        return self;
    }
    fn begin_map(self, n: Int) -> any {
        child = {};
        self.put(child);
        self.h["stack"].append(child);
        self.h["key"] = none;
        return self;
    }
    fn begin_struct(self, name: Str, n: Int) -> any {
        return self.begin_map(n);
    }
    fn begin_enum(self, name: Str, variant: Str, n: Int) -> any {
        return self.begin_map(n);
    }
    fn write_key(self, key: Str) -> any {
        self.h["key"] = key;
        return none;
    }
    fn set_tree(self, tree: any) -> any {
        self.h["tree"] = tree;
        self.h["stack"] = [];
        return none;
    }
    fn end(self) -> any {
        if self.h["stack"].len() > 0 { self.h["stack"].pop(); }
        return self;
    }
    fn finish(self) -> any { return self.h["tree"]; }
}

impl Encoder for TreeEncoder {}

pub struct TreeDecoder {
    h: dict;
    fn read_any(self) -> any { return self.h["tree"]; }
    fn read_bool(self) -> Bool {
        if reflect.kind_of(self.h["tree"]) != "bool" { raise("serde decoder: expected bool"); }
        return self.h["tree"];
    }
    fn read_int(self) -> Int {
        if reflect.kind_of(self.h["tree"]) != "int" { raise("serde decoder: expected int"); }
        return self.h["tree"];
    }
    fn read_float(self) -> Float {
        if reflect.kind_of(self.h["tree"]) != "float" { raise("serde decoder: expected float"); }
        return self.h["tree"];
    }
    fn read_str(self) -> Str {
        if reflect.kind_of(self.h["tree"]) != "string" { raise("serde decoder: expected string"); }
        return self.h["tree"];
    }
    fn field(self, key: Str) -> any {
        if reflect.kind_of(self.h["tree"]) != "dict" or not tree_has_key(self.h["tree"], key) {
            raise("serde decoder: missing field " + key);
        }
        return TreeDecoder(h: {"tree": self.h["tree"][key]});
    }
    fn at(self, index: Int) -> any {
        if reflect.kind_of(self.h["tree"]) != "list" { raise("serde decoder: expected sequence"); }
        return TreeDecoder(h: {"tree": self.h["tree"][index]});
    }
    fn len(self) -> Int {
        k = reflect.kind_of(self.h["tree"]);
        if k != "list" and k != "dict" { raise("serde decoder: expected container"); }
        return self.h["tree"].len();
    }
    fn has_key(self, key: Str) -> Bool {
        return reflect.kind_of(self.h["tree"]) == "dict" and tree_has_key(self.h["tree"], key);
    }
}

impl Decoder for TreeDecoder {}

pub fn tree_encoder() -> TreeEncoder {
    return TreeEncoder(h: {"tree": none, "key": none, "stack": []});
}

pub fn tree_decoder(tree: any) -> TreeDecoder {
    return TreeDecoder(h: {"tree": tree});
}

pub fn serialize_into(v: any, encoder: any) -> any {
    encoder.set_tree(codec.enc_tree(v));
    return encoder.finish();
}

pub fn deserialize_from(T: any, decoder: any) -> any {
    return codec.coerce_type(T, decoder.read_any());
}

pub fn deserialize_with(T: any, decoder: any, visitor: any) -> any {
    return codec.coerce_type(T, visitor(decoder));
}

# Format-agnostic trait-facing entry points. Derived types are registered as
# Serialize/Deserialize conformances by the compiler/runtime; these functions
# keep the codec tree independent of any concrete text or binary format.
pub fn serialize(v: any) -> any {
    return codec.enc_tree(v);
}

pub fn deserialize(T: any, data: any) -> any {
    return codec.coerce_type(T, data);
}

# ---- Encoding --------------------------------------------------------------
# Structs/enums/lists/maps become a tree in pat.codec, then JSON text in
# pat.json — output is identical to the original single-module encoder.

pub fn to_json(v: any) -> Str {
    return json.render(serialize(v));
}

pub fn encode(v: any) -> Str {
    return to_json(v);
}

# ---- Decoding --------------------------------------------------------------

# Parse JSON into a dynamic tree (dict/list/str/int/float/bool/none).
pub fn from_json(s: Str) -> any {
    return json.loads(s);
}

pub fn decode(s: Str) -> any {
    return json.loads(s);
}

# Parse JSON and coerce it into `T` (a struct or enum type reference).
pub fn from_json_as(T: any, s: Str) -> any {
    return deserialize(T, json.loads(s));
}
