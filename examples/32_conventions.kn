# 32 — Convention files: main.kn & pin.kn       (plan §3)
# main.kn is the executable ENTRY POINT; pin.kn is a package's INITIALIZER /
# public-API aggregator. This file shows the pin.kn convention in action:
#   - importing the `greet` package (examples/pets/greet) runs its
#     pin.kn exactly once, whatever the import count
#   - pin.kn's `pub` surface is reachable on the package module object
import greet;
import greet as via;      # importing again binds a second name...
import greet as again;    # ...but pin.kn still runs ONCE, not three times

def main() {
    # the package's module state and pub API come from that single init
    print("load_count =", greet.load_count());     # 1, not 3
    print("via        =", via.load_count());       # share the same greeting
    print("again      =", again.load_count());
    print(greet.hello("Kirn"));
}
