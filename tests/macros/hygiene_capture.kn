# The phase-2 verify criterion: a macro must NOT be able to capture a caller
# local. `helper` in the macro body is a free identifier, so it is alpha-renamed
# into the macro's private namespace and must NOT bind to the caller's `helper`.
# The correct program passes `helper` as a parameter instead.
{.fn BAD() = helper + 1.}
{.fn GOOD(h) = h + 1.}
fn main() -> none {
  helper = 100;
  print(GOOD(helper));
}
