fn main() -> none {
    var xs = [1, 2, 3, 4];
    var a = xs.par_iter().map(fn (x) { return x * 2; }).collect();
    var b = xs.into_par_iter().filter(fn (x) { return x > 2; }).collect();
    var total: Int = xs.par_iter().map(fn (x) { return x * 2; }).sum();
    var count: Int = xs.par_iter().count();
    assert(a == [2, 4, 6, 8]);
    assert(b == [3, 4]);
    assert(total == 20);
    assert(count == 4);
    print("parallel method ok");
}
