def bump(st, q) {
    st["pos"] = st["pos"] + 1;
    st["line"] += 2;
    q.append("tok");
    q.append(st["pos"]);
}

def outer(st, q) {
    st["pos"] = 100;
    bump(st, q);
}

def main() {
    var st = {"pos": 0, "line": 1, "spec": ""};
    var q = [];
    outer(st, q);
    print(st["pos"], st["line"]);
    print(q);
    st["spec"] += "x";
    print(st["spec"]);
}