# stdlib/pat/io_test.kn - tests for pat.io.
import pat.io;

fn main() -> none {
    path = ".io_tmp_test.txt";
    seed = io.open_mode(path, "w");
    seed.close();
    io.append_file(path, "hello");
    s = io.read_file(path);
    assert(s == "hello");

    mut f = io.open_mode(path, "w+");
    f.write("abcdef");
    assert(f.tell() == 6);
    assert(f.seek(1, 0) == 1);
    assert(f.read(3) == "bcd");
    f.truncate(4);
    assert(f.seek(0, 0) == 0);
    assert(f.read() == "abcd");
    f.close();

    f = io.open_mode(path, "w");
    f.write_w("fresh");
    f.close();
    assert(io.read_file(path) == "fresh");

    print("io_test ok");
}
