# stdlib/pet/sync_test.kn - tests for the pet.sync primitives and channels
# (Barrier, Semaphore, Notify, Oneshot, Broadcast, Watch - POWER_PLAN §6).
#
# Every test is deterministic: blocking waits are paired either with a stored
# permit/notification (signal-before-wait is safe by design) or with an
# explicit spawn + join, cross-thread results land in slots printed only
# after all threads are joined, and the notify tests poll waiter_count()
# before broadcasting so a notification can never be delivered into the
# void before its waiter has registered.

import pet.sync as sync;

# ---- Barrier ----------------------------------------------------------------

fn test_barrier_single_party() -> none {
    var b = sync.Barrier(1);
    var g = b.wait();
    assert(g == 0);
    g = b.wait();
    assert(g == 1);
    print("barrier single party: ok");
}

fn test_barrier_four_parties() -> none {
    var results = [0, 0, 0, 0];
    var b = sync.Barrier(4);
    var h1 = spawn fn () -> none {
        var g = b.wait();
        results[0] = g + 1;
        b.wait();
        results[3] = 10;
    };
    var h2 = spawn fn () -> none {
        var g = b.wait();
        results[1] = g + 1;
        b.wait();
    };
    var h3 = spawn fn () -> none {
        var g = b.wait();
        results[2] = g + 1;
        b.wait();
    };
    var g = b.wait();
    assert(g == 0);
    # round 2 must be entered by main before joining: the child threads are
    # already blocked waiting for the second release
    var g2 = b.wait();
    assert(g2 == 1);
    h1.join();
    h2.join();
    h3.join();
    # every party saw generation 0 in round 1 -> slot values are 1
    assert(results[0] == 1);
    assert(results[1] == 1);
    assert(results[2] == 1);
    assert(results[3] == 10);
    print("barrier four parties: ok");
}

# ---- Semaphore --------------------------------------------------------------

fn test_semaphore_counts() -> none {
    var s = sync.Semaphore(2);
    assert(s.available() == 2);
    assert(s.try_acquire());
    assert(s.try_acquire());
    assert(not s.try_acquire());
    assert(s.available() == 0);
    s.release();
    assert(s.available() == 1);
    assert(s.try_acquire_n(1));
    assert(not s.try_acquire());
    s.release_n(2);
    assert(s.available() == 2);
    s.acquire_n(2);
    assert(s.available() == 0);
    print("semaphore counts: ok");
}

fn test_semaphore_blocking_acquire() -> none {
    var s = sync.Semaphore(0);
    var slot = [0];
    var h = spawn fn () -> none {
        s.acquire();
        slot[0] = 1;
        s.release();
    };
    # store the permit - safe whether the waiter is already blocked or not
    s.release();
    h.join();
    assert(slot[0] == 1);
    assert(s.available() == 1);
    print("semaphore blocking acquire: ok");
}

fn test_semaphore_release_n_wakes_two_waiters() -> none {
    var s = sync.Semaphore(0);
    var slots = [0, 0];
    var h1 = spawn fn () -> none {
        s.acquire();
        slots[0] = 1;
    };
    var h2 = spawn fn () -> none {
        s.acquire();
        slots[1] = 1;
    };
    # permits are stored either way, so both waiters are released
    s.release_n(2);
    h1.join();
    h2.join();
    assert(slots[0] == 1);
    assert(slots[1] == 1);
    assert(s.available() == 0);
    print("semaphore release n wakes two: ok");
}

fn test_semaphore_limits_concurrency() -> none {
    var s = sync.Semaphore(1);
    var active = [0];
    var peak = [0];
    var h1 = spawn fn () -> none {
        s.acquire();
        var a = active[0] + 1;
        active[0] = a;
        if a > peak[0] { peak[0] = a; }
        active[0] = active[0] - 1;
        s.release();
    };
    var h2 = spawn fn () -> none {
        s.acquire();
        var a = active[0] + 1;
        active[0] = a;
        if a > peak[0] { peak[0] = a; }
        active[0] = active[0] - 1;
        s.release();
    };
    h1.join();
    h2.join();
    # with one permit the critical sections cannot overlap
    assert(peak[0] == 1);
    assert(s.available() == 1);
    print("semaphore limits concurrency: ok");
}

# ---- Notify -----------------------------------------------------------------

fn test_notify_stores_permit() -> none {
    var n = sync.Notify();
    n.notify_one();
    n.notify_one();
    # only one permit is stored; consume it before spawning so main never
    # races the child for it
    n.wait();
    assert(n.waiter_count() == 0);
    var slot = [0];
    var h = spawn fn () -> none {
        n.wait();
        slot[0] = 1;
    };
    # permit already consumed -> this reaches the waiter when it registers,
    # or stores a permit if it has not registered yet; both paths complete
    n.notify_one();
    h.join();
    assert(slot[0] == 1);
    print("notify stores permit: ok");
}

fn test_notify_two_waiters() -> none {
    var n = sync.Notify();
    var a = [0];
    var b = [0];
    var h1 = spawn fn () -> none {
        n.wait();
        a[0] = 1;
    };
    var h2 = spawn fn () -> none {
        n.wait();
        b[0] = 1;
    };
    # poll until both are registered inside wait() so the broadcast below
    # cannot fire into an empty waiter set
    while n.waiter_count() < 2 { }
    n.notify_waiters();
    h1.join();
    h2.join();
    assert(a[0] == 1);
    assert(b[0] == 1);
    # notify_one reaches one waiter at a time; with both registered first,
    # two notify_ones always release both (each goes down the waking path)
    var c = [0];
    var d = [0];
    var h3 = spawn fn () -> none {
        n.wait();
        c[0] = 1;
    };
    var h4 = spawn fn () -> none {
        n.wait();
        d[0] = 1;
    };
    while n.waiter_count() < 2 { }
    n.notify_one();
    n.notify_one();
    h3.join();
    h4.join();
    assert(c[0] == 1);
    assert(d[0] == 1);
    print("notify two waiters: ok");
}

# ---- Oneshot ----------------------------------------------------------------

fn test_oneshot_roundtrip() -> none {
    var o = sync.Oneshot();
    assert(o.is_empty());
    o.send(11);
    assert(not o.is_empty());
    assert(o.try_recv() == 11);
    assert(o.is_empty());
    assert(o.try_recv() == none);
    # a value sent before recv is called is stored and delivered on recv
    var slot = [0];
    var h = spawn fn () -> none {
        slot[0] = o.recv();
    };
    o.send(22);
    h.join();
    assert(slot[0] == 22);
    print("oneshot roundtrip: ok");
}

fn test_oneshot_close() -> none {
    var o = sync.Oneshot();
    o.close();
    assert(o.is_closed());
    # closed and empty -> recv does not block, yields none
    assert(o.recv() == none);
    print("oneshot close: ok");
}

# ---- Broadcast --------------------------------------------------------------

fn test_broadcast_fanout() -> none {
    var b = sync.Broadcast(4);
    var r1 = b.subscribe();
    var r2 = b.subscribe();
    assert(b.receiver_count() == 2);
    assert(b.send(5) == 2);
    assert(r1.try_recv() == 5);
    assert(r2.try_recv() == 5);
    assert(r1.try_recv() == none);
    assert(b.len() == 1);
    print("broadcast fanout: ok");
}

fn test_broadcast_subscribe_sees_future_only() -> none {
    var b = sync.Broadcast(4);
    var r0 = b.subscribe();
    b.send(1);
    var r1 = b.subscribe();
    # r1 must not observe the value sent before it subscribed
    assert(r1.try_recv() == none);
    assert(r0.try_recv() == 1);
    print("broadcast subscribe future only: ok");
}

fn test_broadcast_lag() -> none {
    var b = sync.Broadcast(2);
    var r = b.subscribe();
    b.send(1);
    b.send(2);
    b.send(3);
    b.send(4);
    # capacity 2 retains [3, 4]; r missed 1 and 2
    assert(r.lagged() == 2);
    # the receiver resumes at the oldest retained message
    assert(r.try_recv() == 3);
    assert(r.try_recv() == 4);
    assert(r.try_recv() == none);
    assert(r.lagged() == 2);
    print("broadcast lag: ok");
}

fn test_broadcast_close_drains() -> none {
    var b = sync.Broadcast(2);
    var r = b.subscribe();
    b.send(9);
    b.close();
    assert(b.is_closed());
    # retained values are still readable after close
    assert(r.recv() == 9);
    assert(r.recv() == none);
    print("broadcast close drains: ok");
}

# ---- Watch ------------------------------------------------------------------

fn test_watch_changed() -> none {
    var w = sync.Watch(1);
    var rx = w.subscribe();
    assert(rx.borrow() == 1);
    assert(not rx.has_changed());
    var slot = [0];
    var h = spawn fn () -> none {
        if rx.changed() {
            slot[0] = rx.borrow();
        }
    };
    w.send(2);
    h.join();
    assert(slot[0] == 2);
    # changed() marked the new version as seen
    assert(not rx.has_changed());
    print("watch changed: ok");
}

fn test_watch_borrow_vs_update() -> none {
    var w = sync.Watch(1);
    var rx = w.subscribe();
    w.send(5);
    assert(rx.has_changed());
    # borrow reads without marking seen
    assert(rx.borrow() == 5);
    assert(rx.has_changed());
    # borrow_and_update marks the value seen
    assert(rx.borrow_and_update() == 5);
    assert(not rx.has_changed());
    assert(w.send_replace(6) == 5);
    assert(rx.has_changed());
    print("watch borrow vs update: ok");
}

fn test_watch_mark() -> none {
    var w = sync.Watch(0);
    var rx = w.subscribe();
    w.send(3);
    assert(rx.has_changed());
    rx.mark_unchanged();
    assert(not rx.has_changed());
    rx.mark_changed();
    assert(rx.has_changed());
    print("watch mark: ok");
}

fn test_watch_close() -> none {
    var w = sync.Watch(0);
    var rx = w.subscribe();
    w.send(1);
    w.close();
    assert(w.is_closed());
    # unseen value + closed -> changed() still returns true once
    assert(rx.changed());
    # seen value + closed -> changed() returns false
    assert(not rx.changed());
    print("watch close: ok");
}

fn main() -> none {
    test_barrier_single_party();
    test_barrier_four_parties();
    test_semaphore_counts();
    test_semaphore_blocking_acquire();
    test_semaphore_release_n_wakes_two_waiters();
    test_semaphore_limits_concurrency();
    test_notify_stores_permit();
    test_notify_two_waiters();
    test_oneshot_roundtrip();
    test_oneshot_close();
    test_broadcast_fanout();
    test_broadcast_subscribe_sees_future_only();
    test_broadcast_lag();
    test_broadcast_close_drains();
    test_watch_changed();
    test_watch_borrow_vs_update();
    test_watch_mark();
    test_watch_close();
}
