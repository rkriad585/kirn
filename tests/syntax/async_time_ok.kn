# Async time surface (POWER_PLAN §2.8): Instant/Duration helpers, sleep_until,
# timeout, and interval. Runs identically under the tree-walker and the VM.
import pat.async as a;

async fn work(id: Int, ms: Int) -> Int {
    await a.sleep(ms: ms);
    return id * 10;
}

async fn main() -> none {
    t0 = a.instant();
    await a.sleep(ms: 10);
    print("elapsed>=", a.elapsed(t0) >= 10);
    print("dur:", a.duration_since(t0 + 30, t0));
    print("add:", a.checked_add(2, 3));

    await a.sleep_until(a.instant() + 10);
    print("until ok");
    await a.sleep(a.duration_ms(1));
    await a.sleep_until(a.now_instant().add(a.duration_ms(1)));

    print("timeout:", await a.timeout(1000, work(2, 5)));
    assert((await a.timeout(a.duration_ms(1000), work(4, 5))).is_ok());
    slow = work(3, 250);
    print("timeout slow:", await a.timeout(10, slow));
    assert(slow.is_aborted());
    slow.wait();
    assert(slow.is_finished());

    # Aborting a task while it sleeps must prevent its post-timer side effect.
    var pulse = chan[Int]();
    var sleeper = spawn(async fn () -> none {
        await a.sleep(ms: 200);
        pulse.send(1);
    });
    await a.sleep(ms: 2);
    sleeper.abort();
    await a.sleep(ms: 60);
    var pulseSeen = false;
    select {
        case _v = pulse.recv() { pulseSeen = true; }
        else { pulseSeen = false; }
    }
    assert(not pulseSeen);

    var iv = a.interval(period_ms: 15);
    var n = 0;
    while n < 2 {
        await iv.tick();
        n += 1;
    }
    print("ticks:", n, "period:", iv.period(), "behaviour:", iv.missed_tick_behavior());

    # A cancelled tick must not advance the shared schedule.
    cancelDeadline = a.instant() + 80;
    var cancelIv = a.interval_at(cancelDeadline, 20);
    var cancelTick = cancelIv.tick();
    await a.sleep(ms: 2);
    cancelTick.abort();
    cancelTick.wait();
    await a.sleep(ms: 100);
    assert_eq(cancelIv.state["next_ms"], cancelDeadline);
}
