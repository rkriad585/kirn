import pet.async as a;

async fn answer() -> Int {
    return 7;
}

async fn main() -> none {
    var task = answer();
    task.abort();
    assert(task.is_aborted());
    assert(task.is_finished());

    var value: Int = await answer();
    assert(value == 7);

    var spawned = spawn answer();
    var spawned_value: Int = await spawned;
    assert(spawned_value == 7);

    var set = a.TaskSet();
    var tracked = set.spawn(answer());
    tracked.abort();
    assert(tracked.is_finished());
    assert(set.len() == 1);
    await set.join_next();
    assert(set.is_empty());
}
