# stdlib/pet/os.kn - operating-system helpers (Kirn-written, Phase 6).
# Wraps the runtime `os` pseudo-module (exit/args/getenv). Import with:
#   import pet.os;
#
# The pseudo-module is captured at load time (the module's own namespace is
# bound under the same name `os` in the consumer, which shadows it inside).

priv_args = os.args;
priv_getenv = os.getenv;
priv_exit = os.exit;

# Program arguments (excluding the interpreter itself).
pub fn args() -> list {
    return priv_args();
}

# Environment variable value, or nil if unset.
pub fn getenv(name: Str) -> none {
    return priv_getenv(name);
}

# Exit the program with the given status code.
pub fn exit(code: Int) -> none {
    priv_exit(code);
}