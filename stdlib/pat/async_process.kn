# stdlib/pat/async_process.kn — async process execution (POWER_PLAN §2.9).
#
# Each operation that can block (running to completion, waiting for a child) is
# an `async fn`, so it runs on a task thread and `await` yields to the caller.
# Commands are plain dicts (a reference value), so a `command(...)` accumulator
# stays usable without receiver-field writeback:
#
#   import pat.async as a;
#   var c = a.process.command("printf");
#   a.process.arg(c, "hi");
#   print((await a.process.output(c))["stdout"]);
#
# POSIX only: `spawn` is unavailable on Windows (it raises).
import os;
import time;

# Start building a command for `prog`; add arguments with `arg`/`args`.
pub fn command(prog: Str) -> dict {
    return {"argv": [prog], "stdin": none};
}

pub fn arg(cmd: dict, value: Str) -> none {
    cmd["argv"].append(value);
}

pub fn args(cmd: dict, values: list) -> none {
    for v in values {
        cmd["argv"].append(v);
    }
}

# Provide stdin for the next process invocation. Accepts text or bytes.
pub fn input(cmd: dict, data: any) -> none {
    cmd["stdin"] = data;
}

# Cancel-safe cleanup for child handles owned by an async operation. A normal
# wait marks the child done before returning; cancellation kills and reaps it.
fn cleanup_child(child: dict) -> none {
    if child["done"] != true {
        os.kill(child["pid"]);
        os.wait(child["pid"]);
    }
    os.remove_file(child["out_path"]);
    os.remove_file(child["err_path"]);
    os.remove_file(child["in_path"]);
}

# Run to completion; returns {code, stdout, stderr}. Use `input` to provide
# text or bytes on stdin; otherwise the child receives EOF from an empty file.
pub async fn output(cmd: dict) -> dict {
    child = os.spawn(cmd["argv"], input: cmd["stdin"]);
    child["done"] = false;
    defer cleanup_child(child);
    var code: any = none;
    while code == none {
        code = os.try_wait(child["pid"]);
        if code == none { await time.after(5); }
    }
    out = os.read_file(child["out_path"]);
    er = os.read_file(child["err_path"]);
    result = {"code": code, "stdout": out, "stderr": er};
    child["done"] = true;
    os.remove_file(child["out_path"]);
    os.remove_file(child["err_path"]);
    os.remove_file(child["in_path"]);
    return result;
}

# Run to completion; returns only the exit status.
pub async fn status(cmd: dict) -> Int {
    child = os.spawn(cmd["argv"], input: cmd["stdin"]);
    child["done"] = false;
    defer cleanup_child(child);
    var code: any = none;
    while code == none {
        code = os.try_wait(child["pid"]);
        if code == none { await time.after(5); }
    }
    child["done"] = true;
    os.remove_file(child["out_path"]);
    os.remove_file(child["err_path"]);
    os.remove_file(child["in_path"]);
    return code;
}

# Start the command without waiting; returns a child handle
# {pid, out_path, err_path, in_path}.
pub async fn spawn(cmd: dict) -> dict {
    child = os.spawn(cmd["argv"], input: cmd["stdin"]);
    child["done"] = false;
    return child;
}

# Wait for a spawned child cooperatively; returns its exit status and cleans up
# its temp files. Polling keeps timer cancellation checkpoints available.
pub async fn wait(child: dict) -> Int {
    defer cleanup_child(child);
    var code: any = none;
    while code == none {
        code = os.try_wait(child["pid"]);
        if code == none { await time.after(5); }
    }
    child["done"] = true;
    os.remove_file(child["out_path"]);
    os.remove_file(child["err_path"]);
    os.remove_file(child["in_path"]);
    return code;
}

# Kill a spawned child with SIGKILL.
pub fn kill(child: dict) -> none {
    os.kill(child["pid"]);
}

# Wait for a spawned child, then read and remove its captured output.
pub async fn wait_with_output(child: dict) -> dict {
    defer cleanup_child(child);
    var code: any = none;
    while code == none {
        code = os.try_wait(child["pid"]);
        if code == none { await time.after(5); }
    }
    child["done"] = true;
    out = os.read_file(child["out_path"]);
    er = os.read_file(child["err_path"]);
    os.remove_file(child["out_path"]);
    os.remove_file(child["err_path"]);
    os.remove_file(child["in_path"]);
    return {"code": code, "stdout": out, "stderr": er};
}
