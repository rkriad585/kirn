struct SB {
    parts: list = [];

    fn append(self, s: Str) -> none {
        self.parts.append(s);
    }
    fn sstr(self) -> Str {
        out = "";
        for p in self.parts { out += p; }
        return out;
    }
}

fn main() -> none {
    var b = SB();
    b.append("hello ");
    b.append("world");
    print(b.sstr());
}