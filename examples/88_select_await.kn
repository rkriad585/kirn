# examples/88_select_await.kn - select over await arms (POWER_PLAN §2.10)
import pet.async as a;

async fn work(x: Int, ms: Int) -> Int {
    await a.sleep(ms);
    return x * 2;
}

async fn main() -> none {
    # Distinct sleeps keep the winner deterministic: the fast arm is ready
    # first even though it is second in source order.
    var slow = work(3, 40);
    var fast = work(5, 5);
    select {
        case v = await slow { print(v); }
        case w = await fast { print(w); }
    }
    select {
        case _ = await a.sleep(ms: 10) { print("timer"); }
    }
}
