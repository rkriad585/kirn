# Common derived traits are checker-visible and runtime-backed.
@[derive(Debug, Eq, Hash, Clone, Ord, Default)]
struct Point { x: Int; y: Int; }

@[derive(Debug, Eq, Hash, Clone, Ord, Default)]
enum State { Ready; Failed(code: Int); }

fn main() -> none {
    p = Point(x: 3, y: 4);
    q = p.clone();
    assert(q.eq(p));
    assert(q.debug() == "Point(x: 3, y: 4)");
    assert(q.hash() == p.hash());
    assert(p.cmp(Point(x: 9, y: 0)) < 0);
    assert(p.cmp(Point(x: 3, y: 4)) == 0);
    assert(State.Ready.debug() == "State.Ready");
    assert(State.Ready.eq(State.Ready));
    d = Point.default();
    assert(d.x == 0 and d.y == 0);
    assert(State.default().debug() == "State.Ready");
    print("common derives ok");
}
