# M8: deque / Counter / heaps / collection free-functions check+run clean.
fn main() -> none {
    d = deque([1, 2, 3]);
    d.append(4);
    d.append_left(0);
    assert_eq(len(d), 5);
    assert_eq(d.pop(), 4);
    assert_eq(d.popleft(), 0);
    assert_eq(d[0], 1);

    bounded = Deque([1, 2, 3, 4, 5], maxlen: 2);
    assert_eq(len(bounded), 2);
    assert_eq(bounded[0], 4);

    c = Counter("aabbbc");
    assert_eq(c['a'], 2);
    assert_eq(c['b'], 3);
    assert_eq(c.total(), 6);
    assert_eq(c.len(), 3);
    assert_eq(len(c.most_common(1)), 1);
    c.update("bc");
    assert_eq(c['b'], 4);

    h = [3, 1, 2];
    heapify(h);
    heappush(h, 0);
    assert_eq(heappop(h), 0);
    assert_eq(heappop(h), 1);
    assert_eq(nsmallest(1, [5, 2, 9]), [2]);

    assert_eq(count([1, 2, 2, 3], 2), 2);
    assert_eq(find([10, 20, 30], 20), 1);
    assert_eq(binary_search([1, 3, 5, 7], 5), 2);
    assert_eq(flatten([[1], [2, 3]]), [1, 2, 3]);
    assert_eq(chunk([1, 2, 3], 2), [[1, 2], [3]]);

    evens, odds = partition(fn (x) { return x % 2 == 0; }, [1, 2, 3, 4]);
    assert_eq(evens, [2, 4]);
    assert_eq(odds, [1, 3]);

    g = group_by(fn (x) { return x % 2; }, [1, 2, 3]);
    assert_eq(g[1], [1, 3]);
    assert_eq(g[0], [2]);

    # Counter algebra keeps only positive counts.
    assert_eq((Counter("aab") - Counter("abz"))['a'], 1);
    assert_eq((Counter("aab") + Counter("abz"))['z'], 1);
}

fn assert_eq(a, b) -> none {
    if a != b {
        print("assertion failed");
    }
}
