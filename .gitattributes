# Line endings are fully declared: EVERY text file is stored and checked out as
# LF (including .ps1/.bat - PowerShell and cmd both handle LF fine). To make sure
# git never auto-converts (and never warns "LF/CRLF will be replaced"), disable
# core.autocrlf for this repo:  git config core.autocrlf false
# The working tree then always matches the index, and there are no CRLF churn
# warnings on add/commit.
* text=auto eol=lf

*.co    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.log   text eol=lf
*.toml  text eol=lf
*.ebnf  text eol=lf

# Binary / never-normalized
*.exe   binary
*.cocolib binary
*.png   binary
*.jpg   binary
*.ico   binary
*.zip   binary
