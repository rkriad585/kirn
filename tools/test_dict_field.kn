struct Box {
    var buckets: dict;
    fn put(self, k, v) -> none {
        self.buckets[k] = v;
    }
    fn get(self, k) -> none {
        d = self.buckets;
        return d[k];
    }
}
fn main() -> none {
    b = Box();
    print("initial:", repr(b.buckets));
    b.put("a", 1);
    print("after put:", repr(b.buckets));
    print("get:", b.get("a"));
}