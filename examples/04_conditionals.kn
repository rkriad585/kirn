# 04 — Conditionals & conditional expression form   (plan §5.6)
def grade(score: int) -> string {
    if score >= 90 {
        return "A";
    } elif score >= 80 {
        return "B";
    } elif score >= 70 {
        return "C";
    } else {
        return "F";

}
}
def main() {
    score = 83;
    letter = grade(score);

    # if/else is an EXPRESSION too — no dangling-else ambiguity:
    verdict = if letter == "A" { "outstanding" } else { "keep pushing" };

    print(f"{score} -> {letter} ({verdict})");
}
