# Async filesystem / process / signal surface (POWER_PLAN §2.9). Runs
# identically under the tree-walker and the VM.
import pet.async as a;
import pet.strings as strings;

async fn main() -> none {
    dir = "/tmp/kirn_syntax_async_io";
    await a.fs.create_dir_all(dir);
    p = dir + "/a.txt";
    await a.fs.write(p, "data");
    print("read:", await a.fs.read_to_string(p));
    print("exists:", await a.fs.exists(p));
    print("meta:", (await a.fs.metadata(p))["size"]);

    await a.fs.copy(p, dir + "/b.txt");
    await a.fs.rename(dir + "/b.txt", dir + "/c.txt");
    print("renamed:", await a.fs.exists(dir + "/c.txt"));

    # Large transfers cross the native 64 KiB checkpoints used by async fs
    # and positional/cursor I/O.
    large = dir + "/large.bin";
    payload = strings.repeat("0123456789abcdef", 8192);
    await a.fs.write(large, payload);
    assert((await a.fs.metadata(large))["size"] == payload.len());
    lf = a.io.open(large);
    head = await lf.read(70000);
    tail = await lf.read_to_end();
    assert(head.len() == 70000);
    assert(head.len() + tail.len() == payload.len());
    await a.fs.remove_file(large);

    var c = a.process.command("printf");
    a.process.arg(c, "ok");
    out = await a.process.output(c);
    print("proc:", out["code"], out["stdout"]);
    print("status:", await a.process.status(a.process.command("true")));

    # output/status use cooperative polling and clean up cancelled children.
    slowcmd = a.process.command("sleep");
    a.process.arg(slowcmd, "1");
    tproc = a.process.output(slowcmd);
    tproc0 = a.instant();
    await a.sleep(ms: 5);
    tproc.abort();
    tproc.wait();
    procElapsed = a.elapsed(tproc0);
    assert(procElapsed < 500);

    # A process wait polls cooperatively and can be cancelled before kill.
    var pcancel = a.process.command("sleep");
    a.process.arg(pcancel, "1");
    child = await a.process.spawn(pcancel);
    waiter = a.process.wait(child);
    await a.sleep(ms: 5);
    waiter.abort();
    waiter.wait();
    a.process.kill(child);
    assert((await a.process.wait(child)) >= 128);

    a.signal.install();
    print("pending:", a.signal.pending());

    await a.fs.remove_file(p);
    await a.fs.remove_file(dir + "/c.txt");
}
