# Gate 10 positive fixture: numeric edge cases the float formatter must match
# byte for byte -- +inf, -inf and NaN through kirn.fmt_f64 -- plus casts, unary
# minus, '%', the `and`/`or` lowering, a continue out of a loop, and a bare
# print() for the zero-arg "\n" path. main exits 7.
fn even(n: Int) -> Bool {
    return n % 2 == 0;
}

fn main() -> Int {
    var huge = 1e308;
    var ppos = huge * 10.0;
    var pneg = 0.0 - ppos;
    var pnan = 0.0 * ppos;
    print("inf=", ppos);
    print("ninf=", pneg);
    print("nan=", pnan);
    print("wide=", 123456789012345678);
    print("intcnv=", 3.7 as Int);
    print("fltcnv=", 9 as Float);
    var b = 1;
    print("btrunc=", b as Bool);
    var neg = 0 - 5;
    print("neg=", neg);
    print("fneg=", 0.0 - 2.5);
    var mod = 17 % 5;
    print("mod=", mod);
    var two = 2;
    if even(two) and two > 0 {
        print("both");
    } else {
        print("neither");
    }
    if even(two) or two > 100 {
        print("atleast");
    }
    var acc = 0;
    var k = 0;
    while k < 5 {
        k = k + 1;
        if k == 3 {
            continue;
        }
        acc = acc + k;
    }
    print("acc=", acc);
    print();
    return 7;
}