# stdlib/lib/regexp.co - pattern matching (Coco-written, Phase 6).
# No native regex engine exists in the substrate yet, so this provides an
# honest subset: glob-style wildcard matching (`*` = any run, `?` = one char)
# plus literal find/split helpers. Import with: import lib.regexp;
#
# A full PCRE-style engine can replace these later; the call sites
# (match/find/split/replace) keep their signatures.

# Glob-style match: `*` matches any (possibly empty) run, `?` one char,
# everything else literal.
pub def match(pat: string, s: string) -> bool {
    return glob(pat, s);
}

# First index of `sub` in s, or -1 if absent (via split on the needle).
pub def find(s: string, sub: string) -> int {
    if sub == "" { return 0; }
    parts = s.split(sub);
    if parts.len() <= 1 { return -1; }
    return str(parts[0]).len();
}

# True if `sub` is present in s.
pub def contains(s: string, sub: string) -> bool {
    return s.contains(sub);
}

# Replace every literal occurrence of `from` with `to`.
pub def replace(s: string, from: string, to: string) -> string {
    return s.replace(from, to);
}

# Split on a literal separator.
pub def split(s: string, sep: string) -> list {
    return s.split(sep);
}

# Internal recursive glob matcher. Uses 1-char substrings so no char vs
# string hazards arise.
def glob(pat: string, s: string) -> bool {
    if pat == "" { return s == ""; }
    pc = pat[0..1];
    if pc == "*" {
        if glob(pat[1..pat.len()], s) { return true; }
        if s == "" { return false; }
        return glob(pat, s[1..s.len()]);
    }
    if s == "" { return false; }
    sc = s[0..1];
    if pc == "?" { return glob(pat[1..pat.len()], s[1..s.len()]); }
    if pc == sc { return glob(pat[1..pat.len()], s[1..s.len()]); }
    return false;
}