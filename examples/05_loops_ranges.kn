# 05 — Loops & ranges                     (plan §5.6)
def main() {
    total = 0;
    for i in 0..=10 { # inclusive range: 11 values
        total += i;

}
    evens = [];
    for i in 0..20 { # exclusive range: 20 values
        if i % 2 != 0 {
            continue;
}
        if i > 12 {
            break;
}
        evens.append(i);

}
    words = ["alpha", "beta", "gamma"];
    for w in words { # iterate any collection
        print(w);

}
    n = 3;
    while n > 0 {
        n -= 1;

}
    print(total, evens, n);
}
