# 21 — Modules & visibility              (plan §5.10)
import math; # stdlib module
from text.slug import slugify; # named import
from json import dumps as to_json; # aliased import

pub fn visible_everywhere() -> none { # pub = exported from this module
    pass;

}
fn package_local() -> none { # no pub = package-visible
    pass;

}
fn _private_helper() -> none { # leading underscore = module-private
    pass;

}
fn main() -> none {
    print(math.sqrt(144.0)); # 12.0
    print(slugify("Hello Kirn World")); # hello-kirn-world
    print(to_json({"ok": true}));
    visible_everywhere();
    package_local();
    _private_helper();
}
