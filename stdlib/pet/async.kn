# stdlib/pet/async.kn — async runtime helpers (POWER_PLAN §2).
#
# The async runtime itself is part of the language: `async fn` declares a task
# and `await` drives it to completion. Import this module for the helpers built
# on top of the built-in `time` pseudo-module. Because `async` is a keyword, bind
# the module under another name:
#
#   import pet.async as a;
#   var t = a.sleep(ms: 100);   # a timer future
#   await t;

# §2.9 async filesystem lives in a sibling module, re-exported as `a.fs`.
import pet.async_fs as fs;
# §2.6 async byte I/O, re-exported as `a.io`.
import pet.async_io as io;
# §2.7 async TCP/UDP, re-exported as `a.net`.
import pet.async_net as net;
# §2.9 process execution and signal handling, re-exported as `a.process` /
# `a.signal`.
import pet.async_process as process;
import pet.async_signal as signal;
# §2.5 async synchronization: native mutex/rwlock/once plus the pet.sync
# semaphore/notify/barrier state machines.
import sync as sysnc;
import pet.sync as psync;

# Sleep for `ms` milliseconds. Returns an awaitable timer, so `await sleep(..)`
# cooperates with other tasks instead of blocking a worker thread.
pub fn sleep(ms: Int) -> any {
    return time.after(ms);
}

# Cooperatively yield the current task. A zero-length timer is awaitable.
pub fn yield_now() -> any {
    return time.after(ms: 0);
}

# Epoch milliseconds (same clock as `time.after`).
pub fn now_ms() -> Int {
    return time.now();
}

# ---- time: Instant / Duration / sleep_until / timeout / interval ------------
#
# Kirn has no dedicated Instant/Duration types in v1; both are Int milliseconds
# (Instant = absolute epoch ms on the `time.after` clock, Duration = relative
# ms), so they interoperate with `time.now`/`time.after` and arithmetic. This
# mirrors tokio's `Instant`/`Duration` API (POWER_PLAN §2.8) without adding a
# new nominal type to the language.

# Current Instant (epoch ms). Alias of `now_ms`, named for tokio familiarity.
pub fn instant() -> Int {
    return time.now();
}

# Milliseconds from `earlier` (an Instant) to now. Saturates at 0 if `earlier`
# is in the future, matching `Instant::saturating_duration_since`.
pub fn elapsed(earlier: Int) -> Int {
    d = time.now() - earlier;
    if d < 0 { return 0; }
    return d;
}

# Milliseconds from `earlier` to `later`, or `none` if `later < earlier`
# (mirrors `Instant::checked_duration_since`).
pub fn duration_since(later: Int, earlier: Int) -> any {
    if later < earlier { return none; }
    return later - earlier;
}

# Instant `base + d` (a Duration). Never overflows for realistic clocks.
pub fn checked_add(base: Int, d: Int) -> Int {
    return base + d;
}

# Await a timer that fires at the absolute deadline `deadline_ms` (an Instant).
pub fn sleep_until(deadline_ms: Int) -> any {
    return time.after_at(deadline_ms);
}

# Await `fut` but give up after `ms` milliseconds: `ok(v)` if it finished in
# time, `err("elapsed")` otherwise. `fut` must be an already-started Task (calling
# an `async fn` schedules it); on timeout the task keeps running detached. This
# is the futures that `timeout_at`/`select` are built on (POWER_PLAN §2.8).
pub async fn timeout(ms: Int, fut: any) -> any {
    waited = time.wait(fut, ms);
    if not waited { return err("elapsed"); }
    return ok(await fut);
}

# `timeout` against an absolute deadline (an Instant) instead of a duration.
pub async fn timeout_at(deadline_ms: Int, fut: any) -> any {
    d = deadline_ms - time.now();
    if d < 0 { d = 0; }
    return await timeout(d, fut);
}

# Missed-tick strategies for `Interval.tick` (POWER_PLAN §2.8), matching tokio's
# `MissedTickBehavior`: after work overruns the period, `burst` fires the missed
# ticks back-to-back, `delay` restarts the period from now, and `skip` jumps to
# the next tick aligned to the original schedule. `burst` is the default.
pub const BURST: Str = "burst";
pub const DELAY: Str = "delay";
pub const SKIP: Str = "skip";

# A periodic ticker. Unlike calling `sleep` in a loop, this accounts for the time
# spent doing work between ticks, so the cadence does not drift. The first
# `tick()` resolves immediately after creation (matching tokio's `interval`).
#
# `tick()` is an ordinary (non-`async`) method that advances the schedule and
# returns an awaitable timer, so `await iv.tick()` both waits for the tick and
# persists the new schedule in `iv` (an `async fn` method cannot: its receiver
# is a per-task copy and field writes are not written back). The schedule
# advances when `tick()` is *called*, not when the await resumes - the same
# point tokio's `poll_tick` uses - so `Burst`/`Skip` remain aligned to the
# original phase. The value of `await iv.tick()` is `none`.
struct Interval {
    period_ms: Int;
    next_ms: Int;
    behaviour: Str;

    fn tick(self) -> any {
        now = time.now();
        deadline = self.next_ms;
        # Assume a normal tick: the next one is a full period after the deadline
        # this tick represents (tokio's `Burst` default). Only a genuine overrun
        # (>5ms past the deadline) triggers a missed-tick strategy.
        next = deadline + self.period_ms;
        if now > deadline + 5 {
            if self.behaviour == DELAY {
                # Restart the period from the moment tick() was called.
                next = now + self.period_ms;
            } else if self.behaviour == SKIP {
                # Jump to the next tick aligned to the original phase.
                off = (now - deadline) % self.period_ms;
                next = now + (self.period_ms - off);
            }
            # "burst" keeps next = deadline + period, firing missed ticks
            # back-to-back until caught up.
        }
        self.next_ms = next;
        return time.after_at(deadline);
    }

    fn set_missed_tick_behavior(self, behaviour: Str) -> none {
        self.behaviour = behaviour;
    }

    fn missed_tick_behavior(self) -> Str {
        return self.behaviour;
    }

    fn period(self) -> Int {
        return self.period_ms;
    }

    # Reset so the next `tick()` fires one full period from now.
    fn reset(self) -> none {
        self.next_ms = time.now() + self.period_ms;
    }
}

# Periodic ticker. `behaviour` is one of `BURST`/`DELAY`/`SKIP` (default
# `BURST`). Like tokio's `interval`, the first `tick()` resolves immediately.
# Usage:
#   var iv = a.interval(period_ms: 100);
#   while true { await iv.tick(); ... }
pub fn interval(period_ms: Int) -> Interval {
    if period_ms <= 0 { raise "interval period must be positive"; }
    return Interval(period_ms: period_ms, next_ms: time.now(), behaviour: BURST);
}

# Periodic ticker whose first tick fires at the absolute Instant `start_ms`.
pub fn interval_at(start_ms: Int, period_ms: Int) -> Interval {
    if period_ms <= 0 { raise "interval period must be positive"; }
    return Interval(period_ms: period_ms, next_ms: start_ms, behaviour: BURST);
}

# Await every task in `ts`, returning their results in order (POWER_PLAN §2.10).
# Tasks are scheduled when their `async fn` is called, so they already run
# concurrently; `join` waits for all of them, then re-raises the first error (if
# any) once every task has finished - so a failure never leaves a task unjoined.
# Usage: `var rs = await a.join([t1, t2, t3]);`
pub async fn join(ts: list) -> list {
    var out = [];
    var first = none;
    var failed = false;
    for t in ts {
        try {
            out.append(await t);
        } catch e {
            if not failed {
                failed = true;
                first = e;
            }
            out.append(none);
        }
    }
    if failed {
        raise(first);
    }
    return out;
}

# Await tasks in order, short-circuiting on the first raise (POWER_PLAN §2.10):
# the error propagates immediately and the remaining handles are cancelled
# (`abort()`), so a later await of one returns `none` instead of blocking.
# Because calling an `async fn` already started the task, cancellation flags
# the handle; the eager OS thread still finishes its current work.
pub async fn try_join(ts: list) -> list {
    var out = [];
    for i in 0..ts.len() {
        try {
            out.append(await ts[i]);
        } catch e {
            for j in 0..ts.len() {
                if j > i { ts[j].abort(); }
            }
            raise(e);
        }
    }
    return out;
}

# ---- §2.3 tasks: TaskSet / abort / spawn_blocking ---------------------------
#
# Calling an `async fn` starts the task eagerly, so a TaskSet *tracks* handles
# rather than scheduling work: `set.spawn(t)` appends one. `join_next` is FIFO
# (there is no completion-order wakeup in the thread-per-task runtime) and a
# task's `raise` surfaces at the await site, as with `join`.

pub struct TaskSetState {
    var ts: list;

    fn spawn(self, t: any) -> any {
        self.ts.append(t);
        return t;
    }

    fn add(self, t: any) -> any {
        return self.spawn(t);
    }

    fn len(self) -> Int {
        return self.ts.len();
    }

    fn is_empty(self) -> Bool {
        return self.ts.len() == 0;
    }

    async fn join_next(self) -> any {
        if self.ts.len() == 0 { return none; }
        t = self.ts.shift();
        return await t;
    }

    async fn join_all(self) -> list {
        out = [];
        while self.ts.len() > 0 {
            t = self.ts.shift();
            out.append(await t);
        }
        return out;
    }

    fn abort_all(self) -> none {
        for t in self.ts {
            t.abort();
        }
        return none;
    }

    async fn shutdown(self) -> list {
        self.abort_all();
        return await self.join_all();
    }
}

pub fn TaskSet() -> TaskSetState {
    return TaskSetState(ts: []);
}

# Run a blocking/CPU closure on an OS thread. Kirn's async tasks are already OS
# threads, so this is `spawn` under tokio's name (there is no separate blocking
# pool; `spawn_blocking` does not require an async context).
pub fn spawn_blocking(f: any) -> any {
    return spawn f();
}

# ---- §2.5 async synchronization ---------------------------------------------
#
# Kirn tasks are OS threads, so a wait blocks only its own task thread; wrapping
# each wait in an `async fn` keeps the shape of tokio's async sync API and lets
# `await` join the wait. There is no poisoning and no RAII drop: guards expose
# `unlock()` (and `Mutex.with` unlocks for you, even on a raise).
#
#   var m = a.Mutex(0);
#   var g = await m.lock();
#   g.set(g.get() + 1);
#   g.unlock();

pub struct MutexState {
    var m: any;      # native sync.Mutex
    var v: list;     # [value] - reference field, shared across receiver copies

    async fn lock(self) -> MutexGuard {
        self.m.lock();
        return MutexGuard(m: self.m, v: self.v);
    }

    # Non-blocking: a guard or `none`.
    fn try_lock(self) -> any {
        if self.m.try_lock() { return MutexGuard(m: self.m, v: self.v); }
        return none;
    }

    # Read without taking the lock (use only when no writer is active).
    fn get(self) -> any {
        return self.v[0];
    }

    # Run `f(value)` under the lock; unlocks even if `f` raises.
    async fn with(self, f: any) -> any {
        self.m.lock();
        defer self.m.unlock();
        return f(self.v[0]);
    }

    fn is_locked(self) -> Bool {
        return self.m.locked();
    }
}

pub struct MutexGuard {
    var m: any;
    var v: list;
    fn get(self) -> any { return self.v[0]; }
    fn set(self, x: any) -> none { self.v[0] = x; }
    fn unlock(self) -> none { self.m.unlock(); }
}

# `Mutex(value)` - a lock plus the value it protects (tokio::sync::Mutex).
pub fn Mutex(value: any) -> MutexState {
    return MutexState(m: sysnc.Mutex(), v: [value]);
}

# ---- RwLock -----------------------------------------------------------------

pub struct RwLockState {
    var m: any;      # native sync.RwMutex
    var v: list;

    async fn read(self) -> ReadGuard {
        self.m.rlock();
        return ReadGuard(m: self.m, v: self.v);
    }

    async fn write(self) -> WriteGuard {
        self.m.lock();
        return WriteGuard(m: self.m, v: self.v);
    }

    fn try_read(self) -> any {
        if self.m.try_rlock() { return ReadGuard(m: self.m, v: self.v); }
        return none;
    }

    fn try_write(self) -> any {
        if self.m.try_lock() { return WriteGuard(m: self.m, v: self.v); }
        return none;
    }

    fn get(self) -> any { return self.v[0]; }
}

pub struct ReadGuard {
    var m: any;
    var v: list;
    fn get(self) -> any { return self.v[0]; }
    fn unlock(self) -> none { self.m.runlock(); }
}

pub struct WriteGuard {
    var m: any;
    var v: list;
    fn get(self) -> any { return self.v[0]; }
    fn set(self, x: any) -> none { self.v[0] = x; }
    fn unlock(self) -> none { self.m.unlock(); }
}

pub fn RwLock(value: any) -> RwLockState {
    return RwLockState(m: sysnc.RwMutex(), v: [value]);
}

# ---- Semaphore --------------------------------------------------------------

pub struct AsyncSemaphore {
    var s: any;      # pet.sync.SemaphoreState

    async fn acquire(self) -> none { self.s.acquire(); }
    async fn acquire_n(self, n: Int) -> none { self.s.acquire_n(n); }
    fn try_acquire(self) -> Bool { return self.s.try_acquire(); }
    fn try_acquire_n(self, n: Int) -> Bool { return self.s.try_acquire_n(n); }
    fn release(self) -> none { self.s.release(); }
    fn release_n(self, n: Int) -> none { self.s.release_n(n); }
    fn available(self) -> Int { return self.s.available(); }
}

pub fn Semaphore(permits: Int) -> AsyncSemaphore {
    return AsyncSemaphore(s: psync.Semaphore(permits));
}

# ---- Notify -----------------------------------------------------------------

pub struct AsyncNotify {
    var n: any;      # pet.sync.NotifyState

    fn notify_one(self) -> none { self.n.notify_one(); }
    fn notify_waiters(self) -> none { self.n.notify_waiters(); }
    # Wait for one notification; a permit stored before the wait is consumed.
    async fn notified(self) -> none { self.n.wait(); }
    fn waiter_count(self) -> Int { return self.n.waiter_count(); }
}

pub fn Notify() -> AsyncNotify {
    return AsyncNotify(n: psync.Notify());
}

# ---- OnceCell ---------------------------------------------------------------

pub struct OnceCellState {
    var o: any;      # native sync.Once
    var v: list;

    fn get(self) -> any {
        if self.o.done() { return self.v[0]; }
        return none;
    }

    fn is_set(self) -> Bool {
        return self.o.done();
    }

    # Initialise once; later calls (and concurrent callers) reuse the value.
    # `f` is a plain function value, called while the Once is locked.
    async fn get_or_init(self, f: any) -> any {
        if not self.o.done() {
            self.o.do(fn () -> none { self.v[0] = f(); });
        }
        return self.v[0];
    }
}

pub fn OnceCell() -> OnceCellState {
    return OnceCellState(o: sysnc.Once(), v: [none]);
}

# ---- Barrier ----------------------------------------------------------------

pub struct AsyncBarrier {
    var b: any;      # pet.sync.BarrierState

    # Blocks until all parties arrive; returns the generation (same for all).
    async fn wait(self) -> Int {
        return self.b.wait();
    }
}

pub fn Barrier(parties: Int) -> AsyncBarrier {
    return AsyncBarrier(b: psync.Barrier(parties));
}

pub fn Mpsc(capacity: Int) -> list {
    return psync.Mpsc(capacity);
}

pub fn Unbounded() -> list {
    return psync.Unbounded();
}

pub fn mpsc(capacity: Int) -> list {
    return psync.Mpsc(capacity);
}

pub fn unbounded() -> list {
    return psync.Unbounded();
}

pub fn oneshot() -> any {
    return psync.Oneshot();
}

pub fn broadcast(capacity: Int) -> any {
    return psync.Broadcast(capacity);
}

pub fn watch(initial: any) -> any {
    return psync.Watch(initial);
}
