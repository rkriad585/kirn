# 06 — Functions: defaults, variadics, fn values, named args   (plan §5.5)
fn add(a: Int, b: Int) -> Int {
    return a + b;

}
fn greet(name: Str = "world") -> none { # default parameter value
    print(f"hello {name}");

}
fn sum_all(*nums: Int) -> Int { # variadic parameter
    total = 0;
    for n in nums {
        total += n;
}
    return total;

}
fn apply(op: fn(Int, Int) -> Int, a: Int, b: Int) -> Int {
    return op(a, b); # functions are first-class values

}
fn main() -> none {
    greet();
    greet(name: "Kirn"); # named argument (colon syntax)
    print(add(2, 3), sum_all(1, 2, 3, 4));
    print(apply(op: add, a: 10, b: 20));
}
