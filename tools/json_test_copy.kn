import lib.json;
def main() {
    o = {};
    o["name"] = "coco";
    o["n"] = 42;
    o["ok"] = true;
    nest = {};
    nest["k"] = "v";
    o["nested"] = nest;
    arr = [1, 2, 3];
    o["list"] = arr;
    txt = json.dumps(o);
    back = json.loads(txt);
    print("N1", back["name"]);
    print("N2", back["n"]);
    print("N3", back["ok"]);
    print("N4", back["nested"]["k"]);
    print("N5", back["list"].len());
    print("N6", back["list"][2]);
    print("json_test ok");
}