# 31 Advanced patterns & labeled loops
# Rust-style: or-patterns, alias bindings (@), slice/tuple rest (..).
# Go-style: labeled break / continue.

pub def fizzbuzz(n: int) -> string {
    match n {
        case x if x % 15 == 0 { return "fizzbuzz"; }
        case x @ (3 | 6 | 9 | 12) {
            if x % 2 == 0 { return "fizz"; }
            return "fizz";
        }
        case 5 | 10 { return "buzz"; }
        case _ { return "n"; }
    }
    return "?";
}

pub def classify(inputs: list[int]) -> list[string] {
    out = [];
    for v in inputs {
        out = out + [fizzbuzz(v)];
    }
    return out;
}

pub def main() {
    print(classify([1, 3, 5, 15, 6, 10, 7]));

    # alias + or-pattern in match
    match (42, 7) {
        case t @ (even, 7) if even % 2 == 0 {
            print(f"tuple alias even={even} whole={t}");
        }
        case _ {
            print("no");
        }
    }

    # slice pattern with rest
    match [10, 20, 30, 40] {
        case [head, ..tail] {
            print(f"head={head} tail={tail}");
        }
    }

    # tuple slice with named rest
    match (1, 2, 3, 4) {
        case (a, b, ..rest) {
            print(f"a={a} b={b} rest={rest}");
        }
    }

    # labeled break out of nested loop
    outer: for i in [0, 1, 2] {
        for j in [0, 1, 2] {
            if i == 1 {
                break outer;
            }
            print(f"({i},{j})");
        }
    }
    print("after-labeled-break");

    # labeled continue skips to next outer iteration
    outer: for i in [1, 2, 3] {
        for j in [1, 2, 3] {
            if j == 3 {
                continue outer;
            }
            print(f"[{i},{j}]");
        }
    }
    print("done");
}
