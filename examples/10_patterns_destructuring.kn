# 10 — Patterns: tuples, constructors, type tests   (plan §5.7)
struct Point {
    x: int;
    y: int;

}
enum Shape {
    Circle(radius: int),
    Rect(w: int, h: int),
    Dot,

}
def area(s: Shape) -> int {
    match s {
        case Circle(r) { # positional payload binding
            return 3 * r * r;
}
        case Rect(w, h) { # tuple-style destructuring
            return w * h;
}
        case Dot {
            return 0;

}
}
}
def main() {
    p = Point(x: 3, y: 4);
    match p {
        case Point(x: 0, y) { # named-field pattern with literal
            print(f"on y-axis at {y}");
}
        case Point(x, y) { # named fields, bound positionally
            print(f"x={x}, y={y}");

}
}
    t = (1, "two", 3.0);
    match t {
        case (a, b, c) { # tuple pattern
            print(a, b, c);

}
}
    code = 42;
    match code {
        case 200..=299 {
            print("success range");
}
        case other is string { # binding with type test (never true here)
            print(other);
}
        case _ {}
}
    print(area(Shape.Circle(radius: 2)), area(Shape.Dot));
}
