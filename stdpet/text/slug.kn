# stdlib/text/slug.kn — URL slugification (pure Kirn, no native stubs)
#
# Converts arbitrary text into a lowercase, hyphen-separated identifier:
#   "Hello, Kirn World!"  ->  "hello-kirn-world"
# Collapsing runs of separators and trimming leading/trailing hyphens
# mirrors the behavior of the original builtin stub.

pub fn slugify(s: Str) -> Str {
    out = "";
    hyphen = false;
    for ch in s {
        c = Ord(ch);
        if c >= 65 and c <= 90 { # 'A'..'Z' -> lowercase
            c = c + 32;
}
        alnum = (c >= 97 and c <= 122) or (c >= 48 and c <= 57);
        if alnum {
            if hyphen and out != "" {
                out = out + "-";
}
            out = out + Chr(c);
            hyphen = false;
        } elif out != "" {
            hyphen = true;
    # trim trailing hyphens
}
}
    while out != "" and out[len(out) - 1] == '-' {
        out = out[0:len(out) - 1];
}
    return out;
}
pub fn is_slug(s: Str) -> Bool {
    if s == "" {
        return false;
}
    for ch in s {
        c = Ord(ch);
        ok = (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or ch == '-';
        if not ok {
            return false;
}
}
    return true;
}
