# 38 — pattern power (Rust PatKind parity)   (DO_FIRST_PLAN Phase 3)
# slice `[a, b, ..rest]`, pure-rest `..`, tuple-rest `(x, y, ..)`, nested
# `@` aliases, and ref `&pat` patterns — expressed with `match`-**as-expression**.

class Point { var x: Int = 0; var y: Int = 0; }

fn describe(xs) -> Str {
    # match used as an EXPRESSION, value flows up (not via statement result).
    return match xs {
        case []                      { "empty"; }
        case [a, b, ..rest]          { "a=" + Str(a) + " b=" + Str(b) + " rest=" + Str(rest); }
        case [a, ..]                 { "front=" + Str(a); }
        case _                       { "other"; }
    };
}

fn tup_sum(t) -> Str {
    return match t {
        case (x, y, ..)              { "t=" + Str(x) + "," + Str(y); }
        case (x,)                    { "one=" + Str(x); }
        case _                       { "none"; }
    };
}

fn main() -> none {
    print(describe([]));
    print(describe([1, 2, 3, 4]));
    print(describe([9]));
    print(describe("nope"));

    print(tup_sum((10, 20, 30, 40)));
    print(tup_sum((7,)));

    n = 3;
    s = match n {
        case v @ (1..=5) { "small " + Str(v); }   # nested @ alias
        case _           { "big"; }
    };
    print("nested @ => " + s);

    p = Point(x: 1, y: 2);
    m = match p {
        case &Point { "borrowed point"; }   # ref pattern (transparent deref)
        case _      { "other"; }
    };
    print("ref pattern => " + m);
}