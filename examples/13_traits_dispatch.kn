# 13 — Traits: static + dynamic dispatch  (plan §5.8)
trait Drawable {
    fn draw(self); # signature-only (no default body)
    fn name(self) -> Str {
        return "drawable"; # default body, overridable

}
}
struct Circle {
    r: f64;

    fn draw(self) -> none { # inherent method on the struct itself
        print(f"inherent draw r={self.r}");

}
}
impl Drawable for Circle { # trait impl provides dispatch methods
    fn draw(self) -> none {
        print(f"circle r={self.r}");

}
    fn name(self) -> Str {
        return "circle";

}
}
fn render(d: Drawable) -> none { # DYNAMIC dispatch via trait object
    d.draw();
    print(d.name());

}
fn render_fast[T is Drawable](d: T) -> none { # STATIC dispatch via monomorphization
    d.draw();

}
fn main() -> none {
    c = Circle(r: 2.5);
    render(c);
    render_fast(c);
}
