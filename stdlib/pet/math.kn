# stdlib/pet/math.kn - numeric helpers (Kirn-written, Phase 6).
# Built on the runtime `sqrt`/`abs`/`float`/`int` builtins. Import with:
#   import pet.math;

pub const PI: Float = 3.1415926535897932384;
pub const E: Float = 2.7182818284590452353;

# Square root via Newton's method (pure Kirn, no native sqrt needed).
pub fn sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    g = x;
    i = 0;
    while i < 40 {
        g = (g + x / g) / 2.0;
        if g * g - x < 1e-12 and g * g - x > -1e-12 { break; }
        i = i + 1;
    }
    return g;
}

pub fn abs(x) -> none {
    if x < 0 { return -x; }
    return x;
}

# Clamp x into [lo, hi] (lo <= hi).
pub fn clamp(x: Float, lo: Float, hi: Float) -> Float {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

# Smaller of two values (works for numbers; strings compare lexically).
pub fn min2(a, b) -> none {
    if a < b { return a; }
    return b;
}

# Larger of two values.
pub fn max2(a, b) -> none {
    if a > b { return a; }
    return b;
}

# Integer exponentiation: base^exp (exp >= 0).
pub fn ipow(base: Int, exp: Int) -> Int {
    r = 1;
    i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}

# Floating power via repeated squaring (exp integral).
pub fn fpow(base: Float, exp: Int) -> Float {
    r = 1.0;
    i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}