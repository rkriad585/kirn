# stdlib/pat/async_net.kn — async TCP/UDP networking (POWER_PLAN §2.7).
#
# The socket calls are blocking POSIX calls (`net.*`); each wrapper is an
# `async fn`, so the operation runs on a task thread and `await` yields to the
# caller (spawn-blocking, like tokio's net without a reactor). Reach it through
# `pat.async` as `a.net`, or import this module directly:
#
#   import pat.async as a;
#   var l = a.net.bind("127.0.0.1:0");
#   print(l.local_addr());
#   var s = await l.accept();
#
# Addresses are "host:port" (IPv6 as "[::1]:port"). `bind` with a ":0" port
# picks an ephemeral port; read it back from `local_addr()`.
import net;
import pat.async_io as aio;

pub struct TcpStream {
    fd: Int;
    peer: Str;

    # Read up to `n` bytes; `""` bytes at EOF.
    async fn read(self, n: Int) -> any {
        return net.tcp_read(self.fd, n);
    }

    async fn read_exact(self, n: Int) -> any {
        out = bytearray([]);
        while out.len() < n {
            part = await self.read(n - out.len());
            if part.len() == 0 { raise "read_exact: unexpected end of stream"; }
            out.extend(part);
        }
        return bytes(out);
    }

    async fn read_to_end(self) -> any {
        out = bytearray([]);
        while true {
            part = await self.read(65536);
            if part.len() == 0 { return bytes(out); }
            out.extend(part);
        }
    }

    # Write all of `data` (Str or bytes); returns bytes written.
    async fn write(self, data: any) -> Int {
        return net.tcp_write(self.fd, data);
    }

    async fn write_all(self, data: any) -> none {
        net.tcp_write(self.fd, data);
    }

    fn set_nodelay(self, enabled: Bool) -> none {
        net.tcp_set_nodelay(self.fd, enabled);
    }

    fn set_keepalive(self, enabled: Bool) -> none {
        net.tcp_set_keepalive(self.fd, enabled);
    }

    fn set_recv_buffer(self, bytes: Int) -> none {
        net.socket_set_recv_buffer(self.fd, bytes);
    }

    fn set_send_buffer(self, bytes: Int) -> none {
        net.socket_set_send_buffer(self.fd, bytes);
    }

    fn peer_addr(self) -> Str {
        return self.peer;
    }

    fn close(self) -> none {
        net.close(self.fd);
    }

    # Split into borrowed read/write halves that share the underlying fd. Both
    # halves must not be closed independently; close the original stream.
    fn split(self) -> list {
        return [ReadHalf(fd: self.fd), WriteHalf(fd: self.fd)];
    }

    # Owned halves have distinct concrete types and can be moved to separate
    # tasks without retaining the TcpStream value. The fd is shared by the
    # halves; neither half closes it independently.
    async fn into_split(self) -> list {
        return [OwnedReadHalf(fd: self.fd), OwnedWriteHalf(fd: self.fd)];
    }
}

pub struct ReadHalf {
    fd: Int;
    async fn read(self, n: Int) -> any {
        return net.tcp_read(self.fd, n);
    }
    async fn read_exact(self, n: Int) -> any {
        out = bytearray([]);
        while out.len() < n {
            part = await self.read(n - out.len());
            if part.len() == 0 { raise "read_exact: unexpected end of stream"; }
            out.extend(part);
        }
        return bytes(out);
    }
    async fn read_to_end(self) -> any {
        out = bytearray([]);
        while true {
            part = await self.read(65536);
            if part.len() == 0 { return bytes(out); }
            out.extend(part);
        }
    }
}

pub struct WriteHalf {
    fd: Int;
    async fn write(self, data: any) -> Int {
        return net.tcp_write(self.fd, data);
    }
    async fn write_all(self, data: any) -> none {
        net.tcp_write(self.fd, data);
    }
}

pub struct OwnedReadHalf {
    fd: Int;
    async fn read(self, n: Int) -> any {
        return net.tcp_read(self.fd, n);
    }
    async fn read_exact(self, n: Int) -> any {
        out = bytearray([]);
        while out.len() < n {
            part = await self.read(n - out.len());
            if part.len() == 0 { raise "read_exact: unexpected end of stream"; }
            out.extend(part);
        }
        return bytes(out);
    }
    async fn read_to_end(self) -> any {
        out = bytearray([]);
        while true {
            part = await self.read(65536);
            if part.len() == 0 { return bytes(out); }
            out.extend(part);
        }
    }
}

pub struct OwnedWriteHalf {
    fd: Int;
    async fn write(self, data: any) -> Int {
        return net.tcp_write(self.fd, data);
    }
    async fn write_all(self, data: any) -> none {
        net.tcp_write(self.fd, data);
    }
}

impl aio.AsyncRead for TcpStream {}
impl aio.AsyncWrite for TcpStream {}
impl aio.AsyncRead for ReadHalf {}
impl aio.AsyncWrite for WriteHalf {}
impl aio.AsyncRead for OwnedReadHalf {}
impl aio.AsyncWrite for OwnedWriteHalf {}

pub struct TcpListener {
    fd: Int;
    addr: Str;

    # Wait for the next connection.
    async fn accept(self) -> TcpStream {
        d = net.tcp_accept(self.fd);
        return TcpStream(fd: d["fd"], peer: d["peer"]);
    }

    fn local_addr(self) -> Str {
        return self.addr;
    }

    fn close(self) -> none {
        net.close(self.fd);
    }

    fn set_reuseaddr(self, enabled: Bool) -> none {
        net.socket_set_reuseaddr(self.fd, enabled);
    }
}

# Bind and listen on `addr` ("host:port", port 0 = ephemeral).
pub fn bind(addr: Str) -> TcpListener {
    d = net.tcp_bind(addr);
    return TcpListener(fd: d["fd"], addr: d["addr"]);
}

# Connect to `addr`; returns a connected stream.
pub async fn connect(addr: Str) -> TcpStream {
    d = net.tcp_connect(addr);
    return TcpStream(fd: d["fd"], peer: d["peer"]);
}

pub struct UdpSocket {
    fd: Int;
    addr: Str;

    async fn send_to(self, data: any, addr: Str) -> Int {
        return net.udp_send_to(self.fd, data, addr);
    }

    # Connect a default peer so send/recv mirror Tokio's connected UDP API.
    fn connect(self, addr: Str) -> none {
        net.udp_connect(self.fd, addr);
    }

    async fn send(self, data: any) -> Int {
        return net.udp_send(self.fd, data);
    }

    # Receive up to `n` bytes: `{data: bytes, addr: "host:port"}`.
    async fn recv_from(self, n: Int) -> dict {
        return net.udp_recv_from(self.fd, n);
    }

    async fn recv(self, n: Int) -> any {
        return net.udp_recv(self.fd, n);
    }

    fn local_addr(self) -> Str {
        return self.addr;
    }

    fn close(self) -> none {
        net.close(self.fd);
    }

    fn set_broadcast(self, enabled: Bool) -> none {
        net.udp_set_broadcast(self.fd, enabled);
    }

    fn set_ttl(self, ttl: Int) -> none {
        net.udp_set_ttl(self.fd, ttl);
    }

    fn set_recv_buffer(self, bytes: Int) -> none {
        net.socket_set_recv_buffer(self.fd, bytes);
    }

    fn set_send_buffer(self, bytes: Int) -> none {
        net.socket_set_send_buffer(self.fd, bytes);
    }
}

pub fn udp_bind(addr: Str) -> UdpSocket {
    d = net.udp_bind(addr);
    return UdpSocket(fd: d["fd"], addr: d["addr"]);
}

# Resolve a host name to a list of addresses (no port).
pub fn lookup_host(host: Str) -> list {
    return net.lookup_host(host);
}
