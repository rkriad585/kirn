# examples/88_select_await.kn - select over await arms (POWER_PLAN §2.10)
import pet.async as a;

async fn work(x: Int) -> Int {
    await a.sleep(ms: 20);
    return x * 2;
}

async fn main() -> none {
    var t1 = work(5);
    var t2 = work(3);
    select {
        case v = await t1 { print(v); }
        case w = await t2 { print(w); }
    }
    select {
        case _ = await a.sleep(ms: 10) { print("timer"); }
    }
}

main();
