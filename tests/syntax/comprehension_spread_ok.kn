# comprehension_spread_ok — M3: `*` unpacking in list/set/dict literals and
# `**` dict unpacking, including inside comprehensions (PEP 448/798).
# Positive: warning-free, tree-walker and VM must agree (gate 2b).
fn main() -> none {
    a = [1, 2, 3];
    b = [4, 5];

    print([*a, *b, 6]);                     # [1, 2, 3, 4, 5, 6]
    print(9 in [*a, 9]);

    print({*a, 3});                         # {1, 2, 3}

    base = {"x": 1};
    merged = {**base, "y": 2};
    print(merged["x"], merged["y"]);        # 1 2

    flat = [*inner for inner in [[1, 2], [3, 4]]];
    print(flat);                            # [1, 2, 3, 4]

    pairs = [{**d} for d in [{"a": 1}, {"b": 2}]];
    print(pairs[0]["a"], pairs[1]["b"]);    # 1 2
}
