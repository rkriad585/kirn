# 11 — Structs: fields, defaults, methods, value semantics   (plan §5.8)
struct Point {
    x: f64;
    y: f64 = 0.0; # field default

    def magnitude(self) -> f64 { # methods live inside the struct
        return sqrt(self.x * self.x + self.y * self.y);

}
    def translate(self, dx: f64, dy: f64) {
        self.x += dx; # allowed because receiver is mutable below
        self.y += dy;

}
}
def main() {
    origin = Point(x: 0.0); # y uses its default
    p = Point(x: 3.0, y: 4.0);

    print(p.magnitude()); # 5.0

    var q = p; # VALUE SEMANTICS: full copy
    q.translate(dx: 10.0, dy: 20.0);
    print(p.x, q.x); # p unchanged: 3.0 13.0

    pts = [Point(x: 1.0), Point(x: 2.0)]; # stored inline & contiguous — cache friendly
    print(origin.y, len(pts));
}
