{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kirn: build (Debug, NMake)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--config", "Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "kirn: verify (all harness gates)",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/gates_linux.sh"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
