# stdlib/pat/json.kn - JSON encode/decode (Kirn-written, Phase 6).
# `dumps` delegates to the native serializer; `loads` is a pure-Kirn recursive
# descent parser producing dict/list/str/float/bool/nil. `to_string` /
# `from_string` are the serde-aware pair (POWER_PLAN §3.3): they walk structs
# and enums through `pat.codec`. Import with:
#   import pat.json;

import pat.codec as codec;
import bytes as byte_ops;
import reflect;

# Writer/reader helpers use Kirn's structural file interface. Any value with
# `write(Str)` or `read()` is accepted, so these also work with buffered or
# test-double streams without coupling JSON to one concrete handle type.

# The native dumper is captured at load time (the module's own namespace is
# bound under the same name `json` in the consumer, which shadows it inside).
priv_dumps = json.dumps;

# Serialize a value to a JSON string (native dumper; structs/enums -> null).
pub fn dumps(v) -> Str {
    return priv_dumps(v);
}

# Serialize any value, struct/enum fields included, to a JSON string.
pub fn to_string(v: any) -> Str {
    return render(codec.enc_tree(v));
}

# Parse JSON and rebuild `T` (struct/enum type reference) from it.
pub fn from_string(T: any, s: Str) -> any {
    return codec.coerce_type(T, loads(s));
}

# Serialize to a writer and return the number of characters written when the
# writer reports one; ordinary Kirn file writers return none, so the public
# result is intentionally none for a stable cross-writer contract.
pub fn to_writer(writer: any, v: any) -> none {
    writer.write(to_string(v));
    return none;
}

# Read the complete input and decode it as `T`.
pub fn from_reader(T: any, reader: any) -> any {
    return from_string(T, reader.read());
}

# Awaitable counterparts for `pat.async_io` and other async stream adapters.
# The synchronous helpers above remain available for legacy writer/reader
# values; these use the AsyncRead/AsyncWrite protocol without coupling JSON to
# a concrete file type.
pub async fn write_to(writer: any, v: any) -> none {
    await writer.write_all(to_string(v));
    return none;
}

pub async fn read_from(T: any, reader: any) -> any {
    data = await reader.read_to_end();
    return from_string(T, byte_ops.to_str(data));
}

# Render a decoded tree (from loads/codec.enc_tree) as JSON text.
pub fn render(v: any) -> Str {
    k = reflect.kind_of(v);
    if k == "none" { return "null"; }
    if k == "bool" {
        if v { return "true"; }
        return "false";
    }
    if k == "int" { return Str(v); }
    if k == "float" { return render_float(v); }
    if k == "string" { return quote(v); }
    if k == "list" { return render_seq(v); }
    if k == "dict" { return render_map(v); }
    return "null";
}

fn render_float(v: any) -> Str {
    s = Str(v);
    if s == "inf" or s == "-inf" or s == "nan" { return "null"; }
    return s;
}

fn render_seq(v: list) -> Str {
    out = "[";
    var first = true;
    for e in v {
        if not first { out = out + ","; }
        first = false;
        out = out + render(e);
    }
    return out + "]";
}

fn render_map(v: dict) -> Str {
    out = "{";
    var first = true;
    for key in v {
        if not first { out = out + ","; }
        first = false;
        out = out + quote(Str(key)) + ":" + render(v[key]);
    }
    return out + "}";
}

fn quote(s: Str) -> Str {
    out = "\"";
    var i = 0;
    while i < s.len() {
        c = s[i..i + 1];
        matched = false;
        if c == "\"" { out = out + "\\\""; matched = true; }
        if c == "\\" { out = out + "\\\\"; matched = true; }
        if c == "\n" { out = out + "\\n"; matched = true; }
        if c == "\t" { out = out + "\\t"; matched = true; }
        if c == "\r" { out = out + "\\r"; matched = true; }
        if not matched { out = out + c; }
        i = i + 1;
    }
    return out + "\"";
}

# Parse a JSON string into Kirn values. Parses objects, arrays, strings,
# numbers, true/false/null. Raises on malformed input.
pub fn loads(s: Str) -> any {
    p = Parser();
    p.init(s);
    return p.parse_value();
}

# Minimal JSON parser. `depth` guards against stack overflow on deeply nested
# input (a pathological `[[[[...]]]]` otherwise recurses one C++ frame per
# level).
struct Parser {
    var src: Str;
    var i: Int;
    var depth: Int;
    fn init(self, s: Str) -> none {
        self.src = s;
        self.i = 0;
        self.depth = 0;
    }
    fn skip_ws(self) -> none {
        while self.i < self.src.len() {
            c = self.peek();
            if c == " " or c == "\n" or c == "\t" or c == "\r" {
                self.i = self.i + 1;
            } else {
                break;
            }
        }
    }
    fn peek(self) -> Str {
        if self.i >= self.src.len() { return ""; }
        return self.src[self.i..self.i + 1];
    }
    fn advance(self) -> none {
        self.i = self.i + 1;
    }
    fn parse_value(self) -> none {
        self.depth = self.depth + 1;
        if self.depth > 128 { raise("json: nested too deep"); }
        self.skip_ws();
        c = self.peek();
        var out = nil;
        var matched = false;
        if c == "{" { out = self.parse_object(); matched = true; }
        if c == "[" { out = self.parse_array(); matched = true; }
        if c == "\"" { out = self.parse_string(); matched = true; }
        if c == "t" { self.expect_lit("true"); out = true; matched = true; }
        if c == "f" { self.expect_lit("false"); out = false; matched = true; }
        if c == "n" { self.expect_lit("null"); out = nil; matched = true; }
        if not matched { out = self.parse_number(); }
        self.depth = self.depth - 1;
        return out;
    }
    fn parse_object(self) -> dict {
        self.advance();
        out = {};
        self.skip_ws();
        if self.peek() == "}" { self.advance(); return out; }
        while true {
            self.skip_ws();
            key = self.parse_string();
            self.skip_ws();
            while self.peek() == ":" {
                self.advance();
            }
            val = self.parse_value();
            out[key] = val;
            self.skip_ws();
            c = self.peek();
            if c == "," { self.advance(); }
            if c == "}" { self.advance(); break; }
            if self.i >= self.src.len() { raise("json: unterminated object"); }
            if c == "" { raise("json: unterminated object"); }
        }
        return out;
    }
    fn parse_array(self) -> list {
        self.advance();
        out = [];
        self.skip_ws();
        if self.peek() == "]" { self.advance(); return out; }
        while true {
            v = self.parse_value();
            out.append(v);
            self.skip_ws();
            c = self.peek();
            if c == "," { self.advance(); }
            if c == "]" { self.advance(); break; }
            if c == "" { raise("json: unterminated array"); }
        }
        return out;
    }
    fn parse_string(self) -> Str {
        self.advance();
        out = "";
        while true {
            if self.i >= self.src.len() { raise("json: unterminated string"); }
            c = self.src[self.i..self.i + 1];
            if c == "\"" { self.advance(); break; }
            if c == "\\" {
                self.advance();
                esc = self.peek();
                if esc == "n" { out = out + "\n"; }
                if esc == "t" { out = out + "\t"; }
                if esc == "r" { out = out + "\r"; }
                if esc == "\"" { out = out + esc; }
                if esc == "\\" { out = out + "\\"; }
                if esc == "/" { out = out + "/"; }
                self.advance();
            } else {
                out = out + c;
                self.advance();
            }
        }
        return out;
    }
    fn parse_number(self) -> any {
        start = self.i;
        var is_float = false;
        while self.i < self.src.len() {
            c = self.src[self.i..self.i + 1];
            if c == " " or c == "," or c == "}" or c == "]" { break; }
            if c == "." or c == "e" or c == "E" { is_float = true; }
            self.advance();
        }
        tok = self.src[start..self.i];
        if is_float { return Float(tok); }
        return Int(tok);
    }
    fn expect_lit(self, lit: Str) -> none {
        if self.src[self.i..self.i + lit.len()] == lit {
            self.i = self.i + lit.len();
        } else {
            raise("json: expected '" + lit + "'");
        }
    }
}
