# 43 — Nested constructs sanity: nested control flow, nested types, and
#      labels combined with do-while / gather / goto.
#
# Expected output:
#   nestedIf=65
#   doubleNest=2
#   deepFor=103
#   doGatherSum=21
#   gotoOut=3

def main() {
    # nested if / elif / else (two levels)
    n = 60;
    if n > 100 { n = 1; }
    elif n > 50 { n = 60; }
    else { n = 0; }
    if n > 0 {
        if n > 10 { n = n + 5; }         # 60 -> 65
        else { n = n - 5; }
    }
    print("nestedIf=" + str(n));

    # two levels of nested for loops with a guarded inner body
    pairs = [];
    for x in 1..3 {
        for y in 1..3 {
            if (x + y) % 2 == 0 { pairs.append(x * y); }
        }
    }
    print("doubleNest=" + str(len(pairs)));   # (1,1)(1,3)(2,2)(3,1)(3,3)=5

    # doubly-nested labeled loops with break-by-outer-label
    total = 0;
    outer: for i in 1..3 {
        inner: for j in 1..3 {
            if i == 2 and j == 2 { break outer; }   # exit BOTH loops at once
            total += 1;
        }
        total += 100;       # skipped when we break outer
    }
    print("deepFor=" + str(total));   # i=1: 2 + 100; i=2: j=1 -> 103, break outer

    # gather computing a running sum of its seeds
    sum = 0;
    gather { 1, 2, 3, 4, 5, 6 } {
        sum += item;
    }
    print("doGatherSum=" + str(sum));

    # goto out of doubly-nested loops to a trailing label
    acc = 0;
    for _ in 0..20 {
        for _ in 0..20 {
            acc += 1;
            if acc == 3 { goto done2; }
        }
    }
done2:
    print("gotoOut=" + str(acc));
}
