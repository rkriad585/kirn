# stdlib/lib/math_test.kn - tests for lib.math.
import lib.math;

def main() {
    assert(math.sqrt(4.0) < 2.001 and math.sqrt(4.0) > 1.999);
    assert_eq(math.abs(-5), 5);
    assert_eq(math.abs(3), 3);
    assert_eq(math.clamp(10.0, 0.0, 5.0), 5.0);
    assert_eq(math.clamp(-10.0, 0.0, 5.0), 0.0);
    assert_eq(math.clamp(2.0, 0.0, 5.0), 2.0);
    assert_eq(math.min2(3, 9), 3);
    assert_eq(math.max2(3, 9), 9);
    assert_eq(math.ipow(2, 10), 1024);
    assert_eq(math.fpow(2.0, 4), 16.0);
    assert(math.PI > 3.1415 and math.PI < 3.1416);

    print("math_test ok");
}