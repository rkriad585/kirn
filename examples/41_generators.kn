# 41 - generators & the `yield` statement (phase 5 coroutines)
# A function containing `yield` is a generator: calling it returns a
# `gen[T]` value whose elements are produced by the `yield` expressions.
# Bare `yield` produces `none`; `return` with a value is rejected.

fn counter(n) -> gen[Int] {          # explicit element type
    for i in 1..=n {
        yield i;
    }
}

fn fib(limit) -> gen[Int] {                      # inferred -> gen[int]
    var a = 1;
    var b = 1;
    while a <= limit {
        yield a;
        (a, b) = (b, a + b);
    }
}

fn combine(items) -> none {                  # mixed values + a bare yield
    yield "start";
    for x in items {
        yield x;
    }
    yield;
}

fn main() -> none {
    s = 0;
    for x in counter(5) {
        s = s + x;
    }
    print("sum=" + Str(s));

    fibs = fib(50).collect();                    # materialize to a list
    print("fibs=" + Str(fibs));

    even = counter(10).filter((x) => x % 2 == 0);
    print("even=" + Str(even.collect()));

    sq = counter(4).map((x) => x * x).collect();
    print("sq=" + Str(sq));

    print("len=" + Str(counter(7).len()));
    print("mixed=" + Str(combine([9, 8]).collect()));
    print("fresh=" + Str(counter(3)));           # repr of a generator
}