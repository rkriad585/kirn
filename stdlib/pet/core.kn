# stdlib/pet/core.kn - core helper functions for the Kirn stdlib.
# These mirror the behaviour of the C++ runtime (src/interp/runtime.cpp) so
# importers observe identical semantics.
#
# NOTE: struct types are NOT exported through the file-backed `import`
# mechanism (only `pub def` functions are), so we expose helpers as functions.

# Read an entire file as a string ("" if the file cannot be opened/read).
pub def read_file(path: string) -> string {
    f = io.open(path);
    s = f.read();
    f.close();
    return s;
}

# Write a string to a file (overwrites). Matches io.write semantics.
pub def write_file(path: string, data: string) {
    f = io.open(path);
    f.write(data);
    f.close();
}

# Integer -> string (runtime str() semantics; base 10).
pub def i2s(n: int) -> string {
    return str(n);
}

# Char -> string (single Unicode code point).
pub def c2s(c) -> string {
    return str(c);
}