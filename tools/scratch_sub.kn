fn probe_list_param(mut_lst) -> none {
    mut_lst[0] = 99;
    mut_lst.append("zzz");
}

struct Lx {
    specBuf: Str = "";
    queue: list = [];

    fn pushq(self, item) -> none {
        self.queue.append(item);
    }
    fn growBuf(self, ch: Char) -> none {
        self.specBuf += Str(ch);
    }
}

fn main() -> none {
    n0 = Ord('\u{0}');
    print(n0);
    var l = [1, 2, 3];
    probe_list_param(l);
    print(l);
    var lx = Lx();
    lx.pushq("t1");
    lx.growBuf('x');
    print(lx.queue, lx.specBuf, len(lx.specBuf));
    s = "abcdef";
    print(s[2..4] == "cd", s[0] == 'a');
    print(Chr(0));
}