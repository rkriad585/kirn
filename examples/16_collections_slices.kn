# 16 — Collections: displays, methods, slicing   (plan §5.4)
def main() {
    nums = [3, 1, 2]; # list display
    nums.append(4);
    nums.sort();
    head = nums[0]; # indexing (bounds-checked)
    middle = nums[1:3]; # slice [start:stop]
    clone = nums[:]; # full copy

    table = {"one": 1, "two": 2}; # dict display
    table["three"] = 3;
    has_two = "two" in table;
    count = len(table);

    tags = {"red", "green"}; # set display
    tags.insert("blue");
    has_red = "red" in tags;

    matrix = [[0, 0], [0, 0]]; # nested lists
    matrix[0][1] = 9;

    print(nums, head, middle, clone);
    print(table["one"], count, has_two, tags, has_red, matrix[0][1]);
}
