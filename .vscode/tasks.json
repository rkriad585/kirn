{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "coco: build (Debug, NMake)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--config", "Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "coco: verify (all harness gates)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/rename_baseline.ps1"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
