# Object-like and function-like macro definitions, both spellings of the
# body separator, and a body that itself contains `.` and `}`.
{.def LIMIT. 10.}
{.def ANSWER = 42.}
{.def SQR(x) = x * x.}
{.def BLOCK() = { 1 }.}
{.def FLOATISH. 1.5.}
def main() {
  print(LIMIT);
  print(ANSWER);
  print(SQR(7));
  print(BLOCK());
  print(FLOATISH);
}
