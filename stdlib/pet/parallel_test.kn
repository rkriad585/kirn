import pet.parallel as parallel;

fn main() -> none {
    assert(parallel.current_num_threads() > 0);

    # join returns both results
    var j = parallel.join(fn () -> Int { return 3; }, fn () -> Int { return 4; });
    assert(j[0] == 3);
    assert(j[1] == 4);

    # invoke preserves order
    var rs = parallel.invoke([
        fn () -> Int { return 1; },
        fn () -> Int { return 2; },
        fn () -> Int { return 3; },
    ]);
    assert(rs.len() == 3);
    assert(rs[0] == 1 and rs[1] == 2 and rs[2] == 3);

    # par_iter map/filter/collect/sum
    assert(parallel.par_iter([1, 2, 3]).map(fn (x) { return x * 10; }).collect() == [10, 20, 30]);
    assert(parallel.par_iter([1, 2, 3, 4]).filter(fn (x) { return x % 2 == 0; }).collect() == [2, 4]);
    assert(parallel.par_iter([1, 2, 3, 4]).sum() == 10);
    assert(parallel.par_iter([2, 3, 4]).product() == 24);
    assert(parallel.par_iter([5, 1, 3]).min() == 1);
    assert(parallel.par_iter([5, 1, 3]).max() == 5);
    assert(parallel.par_iter([1, 2, 3]).count() == 3);
    assert(parallel.par_iter([1, 2, 3]).any(fn (x) { return x == 2; }));
    assert(parallel.par_iter([2, 4]).all(fn (x) { return x % 2 == 0; }));
    assert(parallel.par_iter([1, 2, 3]).reduce(0, fn (a, b) { return a + b; }) == 6);

    # a large parallel map exercises the chunked invoke path
    var big = [];
    var i = 5000;
    while i > 0 { big.append(i); i = i - 1; }
    var doubled = parallel.par_iter(big).map(fn (x) { return x * 2; }).collect();
    assert(doubled.len() == 5000 and doubled[0] == 10000 and doubled[4999] == 2);

    # par_sort is stable and correct on larger input
    var s = parallel.par_sort(big);
    assert(s[0] == 1 and s[s.len() - 1] == 5000 and s.len() == 5000);
    assert(parallel.par_sort_by_key([2, 1, 2, 1], fn (x) { return x; }) == [1, 1, 2, 2]);

    # ---- grouping ops (POWER_PLAN 4.3) ----

    # chunks: fixed size, last chunk holds the remainder
    assert(parallel.par_chunks([1, 2, 3, 4, 5], 2).collect() == [[1, 2], [3, 4], [5]]);
    assert(parallel.par_chunks([1, 2, 3, 4, 5], 3).collect() == [[1, 2, 3], [4, 5]]);
    assert(parallel.par_chunks([], 4).collect() == []);

    # windows: slide by one, so they overlap; empty below the window size
    assert(parallel.par_windows([1, 2, 3, 4], 2).collect() == [[1, 2], [2, 3], [3, 4]]);
    assert(parallel.par_windows([1, 2], 5).collect() == []);

    # split: separators dropped, absent separator returns the whole run,
    # adjacent separators produce empty groups
    assert(parallel.par_split([1, 0, 2, 0, 3], 0).collect() == [[1], [2], [3]]);
    assert(parallel.par_split([1, 2, 3], 9).collect() == [[1, 2, 3]]);
    assert(parallel.par_split([1, 0, 0, 2], 0).collect() == [[1], [], [2]]);

    # chunk_by: groups *consecutive* equal-key elements
    assert(parallel.par_chunk_by([1, 1, 2, 2, 3], fn (x) { return x % 2; })
        .collect() == [[1, 1], [2, 2], [3]]);
    assert(parallel.par_chunk_by([1, 2, 1], fn (x) { return x; })
        .collect() == [[1], [2], [1]]);

    # a chunked iterator maps over whole chunks, then is no longer divided
    var summed = parallel.par_chunks([1, 2, 3, 4, 5, 6], 3).map(
        fn (c) { var t = 0; for e in c { t += e; } return t; });
    assert(summed.collect() == [6, 15]);
    assert(summed.divided == false);

    # filter keeps groups as groups, so the divided flag survives
    assert(parallel.par_chunks([1, 2, 3, 4], 2)
        .filter(fn (c) { return c.len() == 2; }).divided == true);

    # the method form and the par_* entry point agree
    assert(parallel.par_chunks([1, 2, 3], 2).collect()
        == parallel.par_iter([1, 2, 3]).chunks(2).collect());
    assert(parallel.par_windows([1, 2, 3], 2).collect()
        == parallel.par_iter([1, 2, 3]).windows(2).collect());
    assert(parallel.par_split([1, 0, 1], 0).collect()
        == parallel.par_iter([1, 0, 1]).split(0).collect());
    assert(parallel.par_chunk_by([1, 2], fn (x) { return x; }).collect()
        == parallel.par_iter([1, 2]).chunk_by(fn (x) { return x; }).collect());

    # a degenerate size raises instead of spinning forever
    var raised = false;
    try {
        parallel.par_chunks([1, 2], 0).collect();
    } catch e {
        raised = true;
        if e == "" { raised = false; }
    }
    assert(raised);

    # ---- combining / searching combinators (POWER_PLAN 4.2) ----

    xs = parallel.par_iter([1, 2, 3, 4, 5, 6]);

    # filter_map keeps mapped values, drops `none`
    assert(xs.filter_map(fn (x) {
        if x % 2 == 0 { return x * 10; }
        return none;
    }).collect() == [20, 40, 60]);

    # flat_map concatenates the iterables in element order; flatten is one level
    assert(parallel.par_iter([[1, 2], [3], [], [4, 5]])
        .flat_map(fn (g) { return g; }).collect() == [1, 2, 3, 4, 5]);
    assert(parallel.par_iter([[1], [2, 3]]).flatten().collect() == [1, 2, 3]);

    # searching: deterministic, first/last in order
    assert(xs.find_any(fn (x) { return x > 3; }) == 4);
    assert(xs.find_first(fn (x) { return x > 3; }) == 4);
    assert(xs.find_last(fn (x) { return x < 5; }) == 4);
    assert(xs.find_any(fn (x) { return x > 99; }) == none);
    assert(parallel.par_iter([5, 6, 7, 8]).positions(
        fn (x) { return x % 2 == 0; }) == [1, 3]);

    # min/max by comparator and by key
    assert(xs.min_by(fn (a, b) { return a - b; }) == 1);
    assert(xs.max_by(fn (a, b) { return a - b; }) == 6);
    assert(parallel.par_iter(["aa", "b", "ccc"]).min_by_key(
        fn (w) { return w.len(); }) == "b");
    assert(parallel.par_iter(["aa", "b", "ccc"]).max_by_key(
        fn (w) { return w.len(); }) == "ccc");

    # zip truncates to the shorter length; enumerate pairs index then value
    assert(xs.zip(parallel.par_iter([10, 20, 30]))
        == [[1, 10], [2, 20], [3, 30]]);
    assert(parallel.par_iter(["a", "b"]).enumerate() == [[0, "a"], [1, "b"]]);

    # take/skip/step_by are index-space rewrites
    assert(xs.take(2).collect() == [1, 2]);
    assert(xs.skip(4).collect() == [5, 6]);
    assert(xs.step_by(2).collect() == [1, 3, 5]);
    assert(xs.take(99).collect() == [1, 2, 3, 4, 5, 6]);
    assert(xs.skip(99).collect() == []);
    assert(parallel.par_iter([1, 2, 3]).take(0).collect() == []);

    # fold seeds each slice from identity() and combines partials
    assert(parallel.par_iter([1, 2, 3, 4]).fold(
        fn () { return 0; }, fn (a, b) { return a + b; }) == 10);
    # ... and a large input (multiple slices) still reduces correctly
    var many = [];
    var k = 1;
    while k <= 20000 { many.append(k); k = k + 1; }
    assert(parallel.par_iter(many).fold(
        fn () { return 0; }, fn (a, b) { return a + b; }) == 200010000);

    # try_reduce short-circuits on the first err
    assert(parallel.par_iter([1, 2, 3]).try_reduce(
        0, fn (a, b) { return ok(a + b); }) == ok(6));
    var bad = parallel.par_iter([1, 2, -3, 4]).try_reduce(0, fn (a, b) {
        if b < 0 { return err("negative " + Str(b)); }
        return ok(a + b);
    });
    assert(bad.is_err());
    assert(bad.unwrap_err() == "negative -3");

    # for_each_init runs init() per slice and visits every element once. A small
    # input stays on one slice, so a captured list is safe to observe; a large
    # one fans out and must only touch its own `init()` state.
    var visits = [];
    parallel.par_iter([1, 2, 3]).for_each_init(
        fn () { return 0; }, fn (_st, e) { visits.append(e); });
    assert(visits.len() == 3);
    ran = parallel.par_iter(many).for_each_init(
        fn () { return 0; }, fn (_st, e) { if e < 0 { raise "neg"; } });
    assert(ran == none);

    print("parallel_test ok");
}
