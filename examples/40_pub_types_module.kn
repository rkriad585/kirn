pub interface Named {
    fn name(self) -> Str;
}

pub class Dog implements Named {
    name: Str;
    fn speak(self) -> Str { return "woof:" + self.name; }
}

pub record Point(x: Int, y: Int) { }

class Hidden {
    value: Int;
}

# The file is also a directly runnable corpus fixture; keep its exported
# declarations above while giving the standalone runner a harmless entrypoint.
fn main() -> none { }
