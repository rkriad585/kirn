var global_count = 0;

def mutate_list() {
    var st = [0, "abc"];
    def bump() {
        st[0] = st[0] + 1;
        st[1] = st[1] + "x";
    }
    bump();
    bump();
    global_count += 1;
    return st;
}

def read_dict() {
    var d = {"k": 41};
    def bump() {
        d["k"] = d["k"] + 1;
    }
    bump();
    return d["k"];
}

def main() {
    print(mutate_list());
    print(read_dict());
    print("xxxxx"[1..4]);
    print("xxxxx"[-3..-1]);
    print(ord('A'), chr(67));
    c = "Hello"[0];
    print(c, ord(c), c == 'H', c != 'h', c >= 'A', 'a' < 'b', '0' <= c, c <= 'Z');
    print("a" + "b" + "c");
    print(global_count);
}