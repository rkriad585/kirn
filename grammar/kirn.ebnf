# =============================================================================
#  Kirn Language — Normative Grammar (EBNF)
#  File:       grammar/kirn.ebnf
#  Status:     PHASE 0 DRAFT v0.2  (ratification tracked in docs/KIRN_PLAN.md §22)
#  Change rec: v0.2 (2026-09-03) fixes malformed EBNF and adds productions
#              required by the example corpus (examples/01–44 + stdlib *_test.kn):
#              try_stmt/catch, try-expr, match-as-expression, OOP facade
#              (class/interface/record/extends/implements), gather_stmt,
#              ref pattern `&pat`, `fn` alias for `def`, `do_while_stmt` spelling,
#              removed duplicate pattern rules and the undefined `attr_of` /
#              `call_arg_list` / `call_expr` references. ISO EBNF `{ }` is used
#              for all repetition (no stray `*`/`+` postfix).
#  Conformance:
#    * This file is NORMATIVE. The parser (src/parser) must accept exactly the
#      language generated here; golden-file tests derive their expectations
#      from example programs validated against this grammar.
#    * Items tagged [PROVISIONAL] correspond to Open Questions in the plan and
#      may change before spec freeze without a breaking-change announcement.
#
#  Notation (ISO EBNF):
#    =  definition            ;  terminator           |  alternation
#    [ ]  optional (0/1)      { }  repetition (0+)    ( )  grouping
#    (* *) comment            "…"  terminal string
#  Non-terminals starting uppercase are LEXER tokens (§1); lowercase are
#  syntactic rules (§3).
# =============================================================================


# =============================================================================
# §1 LEXICAL GRAMMAR
# =============================================================================

(* --- Source basics ------------------------------------------------------- *)

(* Encoding: UTF-8. File extension: .kn. Layout is free: blocks are delimited
   by '{' ... '}' and simple statements end with ';'. Newlines are plain
   whitespace; indentation is purely cosmetic. *)

LINE_ENDING      = "\n" | "\r\n" ;

WHITESPACE       = " " | "\t" | LINE_ENDING ;     (* never significant *)

COMMENT          = "#" , { any_character_except_newline } ;

(* Line joining inside (), [], {} brackets is automatic because newlines are
   whitespace everywhere. A trailing "\" also joins lines.                    *)


(* --- Identifiers & keywords ---------------------------------------------- *)

IDENTIFIER      = identifier_start , { identifier_continue } ;
identifier_start     = "A".."Z" | "a".."z" | "_" ;
identifier_continue  = identifier_start | "0".."9" ;

(* KEYWORD tokens are matched after IDENTIFIER via exact-set lookup.
   THIS LIST is canonical: it mirrors src/lex/lexer.cpp `isKeyword` exactly
   (additions are ratified through the milestone process, this edition).     *)
KEYWORD         = "def"    | "fn"    | "var"   | "let"   | "if"    | "elif"
                | "else"   | "while" | "for"   | "in"    | "return"| "break"
                | "continue"| "match"| "case"  | "struct"| "enum"  | "trait"
                | "impl"   | "import"| "export"| "pub"   | "defer" | "spawn"
                | "chan"   | "select"| "try"   | "catch" | "raise" | "unsafe"
                | "extern" | "new"   | "box"   | "self"  | "Self"  | "and"
                | "or"     | "not"   | "is"    | "as"    | "true"  | "false"
                | "none"   | "pass"  | "class" | "interface" | "record"
                | "implements" | "extends" | "dynamic" | "None"
                | "del"    | "pr"    | "local" | "global"| "temp"
                | "bucket" ;

(* Contextual (NOT reserved; usable as identifiers):
   "yield" is a statement-start word: at statement position it opens a
   generator `yield [expr]` (see yield_stmt) and it also punctuates the
   comprehension form (§2 level 1); outside those positions it remains a
   plain IDENTIFIER. "gather" likewise opens the worklist loop
   (`gather { seeds } { body }`, see gather_stmt) and the re-queue item
   (`gather <expr>,`) only at those statement positions. "item" is a
   contextual binding for the current worklist head inside a gather body.
   Container/view/error type names below are plain IDENTIFIERs bound in the
   prelude — list[int], gen[T], result[T, E], option[int] / int?, any /
   dynamic all parse through base_type.                                     *)

PRIMITIVE_TYPE_NAME = "int" | "i8" | "i16" | "i32" | "i64"
                    | "u8" | "u16" | "u32" | "u64" | "usize" | "isize"
                    | "f32" | "f64" | "bool" | "char" | "string" | "bytes" ;


(* --- Literals ------------------------------------------------------------- *)

INT_LITERAL     = decimal | hex | octal | binary ;
decimal         = digit , { digit | "_" } ;
hex             = "0x" hex_digit , { hex_digit | "_" } ;
octal           = "0o" octal_digit , { octal_digit | "_" } ;
binary          = "0b" binary_digit , { binary_digit | "_" } ;

FLOAT_LITERAL   = decimal , "." , digit , { digit | "_" }
                | decimal , exponent
                | decimal , "." , digit , { digit | "_" } , exponent ;
exponent        = ("e"|"E") , ["+"|"-"] , digit , { digit } ;

CHAR_LITERAL    = "'" , char_content , "'" ;
STRING_LITERAL  = '"' , { string_char } '"'
                | raw_string | byte_string | c_string ;
raw_string      = 'r"' , { any_char_except_quote } '"' ;
byte_string     = 'b"' , { string_char } '"' ;
c_string        = 'c"' , { string_char } '"' ;   (* NUL-terminated, FFI use *)
(* Escape sequences (interpreted strings): \n \t \r \\ \" \' \0 \u{HEX}      *)

INTERP_STRING   = fstring_open , { fstring_part } , fstring_close ;
(* f"strings": lexed as three tokens (open/parts/close). Interpolation:
     { expr }                     simple
     { expr : format_spec }       printf-style spec (width.precision.type)
   Nested braces inside interpolations count depth in the lexer.             */


(* --- Operators & punctuation --------------------------------------------- *)

OPERATOR        = "**"  | "//"  | "=="  | "!="  | "<="  | ">="  | "<<"
                | ">>"  | "+="  | "-="  | "*="  | "/="  | "%="  | "&="
                | "|="  | "^="  | "<<=" | ">>=" | "..=" | ".."  | "=>"
                | ".?." | "->"  | "+"   | "-"   | "*"   | "/"   | "%"
                | "&"   | "|"   | "^"   | "~"   | "<"   | ">"   | "="
                | "?"   | "@" ;

PUNCTUATION     = "("  | ")"  | "["  | "]"  | "{"  | "}"  | ","  | ":"
                | "."  | ";"  ;


# =============================================================================
# §2 EXPRESSION PRECEDENCE (lowest binds loosest)
# =============================================================================
#
#  Level  Operator(s)                Assoc     Notes
#  -----  -------------------------- --------  -----------------------------
#   17    () [] . .?. ?              left      postfix: call/index/member/
#                                               nil-safe/try-propagate
#   16    **                         right     Python rule: -2**2 == -(2**2)
#   15    unary - + ~ not & *        prefix    &x borrow, *p deref  [PROVISIONAL]
#   14    * / % //                   left      // floor-div (ints)
#   13    + -                        left
#   12    << >>                      left
#   11    &                          left
#   10    ^                          left
#    9    |                          left
#    8    ..  ..=                    none      ranges (exclusive/inclusive)
#    7    < > <= >= == != is in      none*     *chainable, Python semantics:
#                                              a < b < c ≡ (a<b) and (b<c)
#    6    not                        prefix
#    5    and                        left
#    4    or                         left
#    3    =>                         right     lambda arrow
#    2    if c { e1 } else { e2 }    n/a       conditional EXPRESSION form
#    1    for p in e yield e         n/a       comprehension  [PROVISIONAL]
#    (t)  try call(...) / call(...)? n/a       error propagation (try_expr,
#                                              try_suffix) — not precedence-bound
#    (m)  match e { ... }            n/a       match-as-expression (match_expr)
# -----------------------------------------------------------------------------


# =============================================================================
# §3 SYNTACTIC GRAMMAR
# =============================================================================

(* ---- Program ------------------------------------------------------------- *)

program         = { top_item } ;
top_item        = func_def | struct_def | enum_def | trait_def | impl_def
                | class_def | interface_def | record_def
                | const_decl | var_decl | import_decl | export_decl
                | statement ;

(* Project-layout conventions (NOT grammar; ratified Phase 3):
   - main.kn   executable entry point: the file whose main() a build/run invokes.
   - pin.kn    package initializer / public-API aggregator (Python __init__):
               runs exactly once when the package tree is imported, then exposes
               its pub surface on the package module object. Preferred entry over
               mod.kn / <dirname>.kn / a lone *.kn inside a package directory.
   - tests/    <name>_test.kn files invoked by `kirn test`.                *)


(* ---- Imports -------------------------------------------------------------- *)

import_decl     = "import" ( dotted_name [ "as" IDENTIFIER ]
                            | STRING_LITERAL ) [ "as" IDENTIFIER ] , ";"
                | "from" ( dotted_name | STRING_LITERAL )
                  "import" import_item , ";" ;
import_item     = "*" | import_binding ;
import_binding  = IDENTIFIER [ "as" IDENTIFIER ] ;
dotted_name     = IDENTIFIER , { "." , IDENTIFIER } ;
export_decl     = "export" ( import_decl | decl_body ) ;
decl_body       = func_def | struct_def | enum_def | const_decl
                | class_def | interface_def | record_def ;


(* ---- Functions ------------------------------------------------------------ *)

func_def        = visibility , ( "def" | "fn" ) IDENTIFIER [ type_params ]
                  "(" [ param_list ] ")" [ "->" type ] block
                | visibility , "extern" , "def" IDENTIFIER [ type_params ]
                  "(" [ param_list ] ")" [ "->" type ] ";" ;
(* `fn` is a full alias for `def` in declaration position (examples/36,44). *)
visibility      = [ "pub" ] | [ "pr" ] ;
(* `pr` marks a declaration module-private (see §4 note 20).               *)

type_params     = "[" type_param , { "," , type_param } "]" ;
type_param      = IDENTIFIER [ "is" type_bound ] [ "=" type ] ;
(* Phase 5.1: an optional `= <type>` gives the DECLARED DEFAULT for the type
   parameter. It is substituted for the TypeVar when a call leaves the TypeVar
   unconstrained (e.g. `def empty[T = int]() -> list[T]` yields list[int] for
   an unconstrained call). An explicit call-site argument/constraint always
   wins over the default. *)
type_bound      = type ;                       (* trait constraint *)

param_list      = param , { "," , param } [ "," ] ;
param           = [ "var" ] IDENTIFIER [ ":" type ] [ "=" expr ]   (* default *)
                | "*" IDENTIFIER [ ":" type ]                      (* variadic *)
                | "self" [ ":" type ]                              (* methods *)
                ;


block           = "{" , { statement } , "}" ;


(* ---- Structs --------------------------------------------------------------- *)

struct_def      = visibility , "struct" IDENTIFIER [ type_params ]
                  "{" { struct_member } "}" ;
struct_member   = field_def | method_def ;
field_def       = [ "weak" ] , visibility , IDENTIFIER , ":" , type ,
                  [ "=" expr ] , ";" ;
method_def      = func_def ;


(* ---- Enums ------------------------------------------------------------------ *)

enum_def        = visibility , "enum" IDENTIFIER [ type_params ]
                  "{" , variant , { enum_sep , variant } , [ enum_sep ] , "}" ;
enum_sep        = "," | ";" ;
(* Phase 5.3: variants may be separated by "," or ";" (C-style); a trailing
   separator is allowed. Each variant carries an implicit discriminant equal to
   its zero-based position; `variant.to_int()` yields that discriminant at run
   time (see §4 notes). *)
variant         = IDENTIFIER                                            (* unit  *)
                | IDENTIFIER , "(" [ payload_param ,
                    { "," , payload_param } ] ")" ;                     (* named *)
payload_param   = IDENTIFIER , ":" , type ;


(* ---- Traits & impls ---------------------------------------------------------- *)

trait_def       = visibility , "trait" IDENTIFIER [ type_params ]
                  "{" { trait_method } "}" ;
trait_method    = func_sig                       (* signature only, ';'      *)
                | func_def ;                     (* default body             *)
func_sig        = visibility , ( "def" | "fn" ) IDENTIFIER [ type_params ]
                  "(" [ param_list ] ")" [ "->" type ] , ";" ;

impl_def        = "impl" [ type_params ] , type , "for" , type ,
                  block ;


(* ---- OOP facade: class / interface / record ---------------------------------------- *)
(* The OOP forms desugar onto the struct/trait/impl model (see §4 note 25):
     class Name implements I1, I2 { ... }  ->  struct + inherent impl + trait impls
     class Derived extends Base { ... }     ->  single inheritance, virtual dispatch
     interface I { def m(self) -> T; }      ->  trait (Go-style structural bound)
     record Name(f: T, ...)                 ->  immutable field tuple (value type)  *)

class_def       = visibility , "class" IDENTIFIER [ type_params ]
                  [ "implements" type_name , { "," , type_name } ]
                  [ "extends" type_name ]
                  "{" { struct_member } "}" ;
interface_def   = visibility , "interface" IDENTIFIER [ type_params ]
                  "{" { trait_method } "}" ;
record_def      = visibility , "record" IDENTIFIER
                  "(" [ record_field , { "," , record_field } ] [ "," ] ")"
                  block ;
record_field    = IDENTIFIER , ":" , type ;
type_name       = IDENTIFIER [ type_args ] ;
type_args       = "[" type_list "]" ;


(* ---- Constants & variables ---------------------------------------------------- *)

const_decl      = visibility , "const" IDENTIFIER [ ":" type ] , "=" expr , ";" ;
var_decl        = "var" target [ ":" type ] [ "=" expr ] ;


(* ---- Statements ------------------------------------------------------------------ *)

statement       = func_def | labeled_stmt | simple_stmt | compound_stmt ;
labeled_stmt    = IDENTIFIER , ":" , ( while_stmt | for_stmt )
                | IDENTIFIER , ":" , statement ;
(* `label: while ... { }` / `label: for ... { }` — targets of `break label;`
   and `continue label;` (Rust/Go loop-label style). A plain `label: <stmt>`
   is a jump label: the target of a safe `goto label;` (a no-op marker whose
   body is the labeled statement). Disambiguated from `name : Type = value`
   (annotated binding) by the presence of a top-level `=` after the type.   *)

simple_stmt     = ( import_decl | export_decl | const_decl
                  | assignment | aug_assign | var_decl | return_stmt
                  | raise_stmt | break_stmt | continue_stmt | defer_stmt
                  | del_stmt | yield_stmt | local_stmt | global_stmt
                  | temp_stmt | bucket_stmt | goto_stmt | gather_item_stmt
                  | pass_stmt | expr_stmt ) , ";" ;

pass_stmt       = "pass" ;

assignment      = target_list "=" expr_list ;
aug_assign      = target aug_op expr ;
aug_op          = "+=" | "-=" | "*=" | "/=" | "%=" | "**=" | "//="
                | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

target_list     = target , { "," , target } ;
target          = IDENTIFIER | tuple_target | index_target | member_target ;
tuple_target    = "(" target , { "," , target } [ "," ] ")"
                | target , "," , target ;
index_target    = primary_expr "[" expr "]" ;
member_target   = primary_expr "." IDENTIFIER ;

return_stmt     = "return" [ expr_list ] ;
raise_stmt      = "raise" expr ;
break_stmt      = "break" [ IDENTIFIER ] ;          (* labeled break          *)
continue_stmt   = "continue" [ IDENTIFIER ] ;       (* labeled continue       *)
goto_stmt       = "goto" IDENTIFIER , ";" ;
(* Safe `goto`: may jump to a `label:` declared in the same block or any
   enclosing block of the same function; a forward jump may not cross a
   declaring statement (`var`/`const`/`local`/`temp`/`bucket`/defs/imports).
   It can never jump INTO a nested block or across a function boundary.    *)
gather_item_stmt = "gather" expr , "," , ";" ;
(* `gather <expr>,` inside a `gather { ... }` body appends the value to the
   loop's worklist; only valid within a gather body (checked statically).  *)
defer_stmt      = "defer" call_expr ;            (* Go-style: call only *)
del_stmt        = "del" target ;
(* `del` removes a binding (del x), a dict key / list index (del d[k]) or a
   struct field (del obj.f); the runtime panics if the target is undefined. *)

yield_stmt      = "yield" [ expr ] ;
(* Statement form of generator functions (contextual word). A `def` whose own
   body contains a `yield` returns gen[T]; bare `yield` produces `none`.  *)

local_stmt      = "local" IDENTIFIER [ ":" type ] [ "=" expr ] ;
global_stmt     = "global" IDENTIFIER [ ":" type ] [ "=" expr ] ;
(* Strict-scope bindings: `local x` rebinds a fresh `x` in the current frame
   (shadowing an outer binding); `global x` (re)binds the module-global x. *)

temp_stmt       = "temp" IDENTIFIER INT_LITERAL [ ":" type ] "=" expr ;
(* Compile-time usage budget: the value may be read at most INT_LITERAL
   (1..10) times; the (N+1)-th read is a compile error.                   *)

bucket_stmt     = "bucket" "release" IDENTIFIER
                | "bucket" IDENTIFIER [ "=" expr ] ;
(* Park/release store: `bucket x = v` moves `x` into the bucket namespace
   (invisible to normal lookup); `bucket release x` moves it back.        *)

expr_stmt       = expr ;
call_expr       = postfix_expr ;
(* A call-only expression (at least one call_suffix); used by `defer`/`spawn`. *)

compound_stmt   = if_stmt | while_stmt | do_while_stmt | for_stmt
                | match_stmt | select_stmt | unsafe_block | spawn_stmt
                | gather_stmt | try_stmt ;

if_stmt         = "if" expr block { "elif" expr block }
                  [ "else" block ] ;
(* `elif` is accepted as a legacy alias for `else if` (see §4 note 2).     *)

while_stmt      = "while" expr block ;

do_while_stmt   = "do" block "while" ( expr | pattern , "=" , expr ) , ";" ;

for_stmt        = "for" pattern "in" expr block ;

match_stmt      = "match" expr "{" { match_arm } "}" ;
match_arm       = "case" pattern [ "if" expr ] block ;

select_stmt     = "select" "{" { select_arm } "}" ;
select_arm      = "case" [ IDENTIFIER "=" ] chan_op block ;
chan_op         = [ "<-" ] , expr ;
(* "<-expr" receives and discards (e.g. <-timer.after(...)).
   Plain expr forms: ch.recv(), ch.send(v).
   [PROVISIONAL] exact send/receive spelling pending concurrency RFC.       *)

unsafe_block    = "unsafe" block ;

spawn_stmt      = "spawn" call_expr ;            (* fire-and-forget spawn *)

gather_stmt     = "gather" "{" seed_expr , { "," , seed_expr } [ "," ] "}"
                  block ;
(* Worklist loop: the block body may re-queue values with `gather expr,`
   (gather_item_stmt); iteration ends when the worklist is empty or a
   `break;` fires. `item` names the current head inside the body.        *)
seed_expr       = expr ;

try_stmt        = "try" block [ catch_clause ] ;
catch_clause    = "catch" [ IDENTIFIER ] block ;
(* `try { } catch e { }`: if `raise(v)` fires inside the try block the flow
   jumps to the catch block binding `e` to `v`; `catch { }` discards the
   value; a `try` without `catch` re-raises (see §4 note 26 and
   examples/35).                                                          *)


(* ---- Expressions --------------------------------------------------------------- *)

expr_list       = expr , { "," , expr } [ "," ] ;

expr            = try_expr | match_expr | closure_expr | lambda_expr
                | conditional_expr | comprehension_expr | orexpr ;

lambda_expr     = param_list_no_default , "=>" , expr ;
param_list_no_default = "(" [ IDENTIFIER { "," IDENTIFIER } ] ")" ;

(* Block-bodied closure: `fn (params) [-> ret] { stmts }`. The `fn` here is a
   contextual prefix inside an expression — a `(` right after `fn` signals the
   closure, otherwise `fn` starts a function declaration. The block runs in a
   fresh scope; `return v;` supplies the value (SignalReturn). Closures capture
   the defining environment. §4 note 10. *)
closure_expr    = "fn" , param_list , [ "->" , type ] , block ;

conditional_expr= "if" expr block_expr "else" block_expr ;
block_expr      = "{" , { statement } , "}" ;   (* expression-position block *)
(* The `if ... { c } else { e }` conditional is an EXPRESSION with no
   dangling-else ambiguity; its branches are the same brace blocks as
   statements and may themselves contain statements (the block's yielded
   value is the final expression statement).                        *)

match_expr      = "match" expr "{" { match_arm } "}"
                  [ "else" block_expr ] ;
(* `match` may appear as a STATEMENT (match_stmt) or, when used in an
   expression position with a value flowing up, as an EXPRESSION (see
   examples/38). A trailing `else { }` supplies the value when no arm
   matches a non-exhaustive scrutinee.                            *)

try_expr        = "try" expr ;
(* Prefix error-propagation form: `try call(...)` returns early from the
   enclosing `result[T,_]`-returning function on Err, equivalent to the
   postfix `call(...)?` (see try_suffix and §4 note 6).            *)

comprehension_expr                                   (* [PROVISIONAL] OQ #2 *)
                = "for" pattern "in" expr { comp_clause } "yield" expr ;
comp_clause     = "for" pattern "in" expr | "if" expr ;

orexpr          = andexpr , { "or"  , andexpr } ;
andexpr         = notexpr , { "and" , notexpr } ;
notexpr         = "not" notexpr | comparison ;

comparison      = range_expr , { compare_op , range_expr } ;   (* chainable  *)
compare_op      = "<" | ">" | "<=" | ">=" | "==" | "!=" | "is" | "in" ;

range_expr      = bitor_expr , [ range_op , bitor_expr ] ;     (* non-assoc  *)
range_op        = ".." | "..=" ;

bitor_expr      = bitxor_expr , { "|"  , bitxor_expr } ;
bitxor_expr     = bitand_expr , { "^"  , bitand_expr } ;
bitand_expr     = shift_expr  , { "&"  , shift_expr } ;
shift_expr      = arith_expr  , { shiftop , arith_expr } ;
shiftop         = "<<" | ">>" ;

arith_expr      = term , { addop , term } ;
addop           = "+" | "-" ;
term            = unary , { mulop , unary } ;
mulop           = "*" | "/" | "%" | "//" ;

unary           = unary_op , unary | power ;
unary_op        = "-" | "+" | "~" | "not" | "&" | "*" ;   (* &/* prov.  *)

power           = postfix_expr , [ "**" , unary ] ;       (* right-assoc *)

postfix_expr    = primary_expr , { postfix_op } ;
postfix_op      = call_suffix | index_suffix | member_suffix | try_suffix ;
call_suffix     = "(" [ call_arg , { "," , call_arg } ] [ "," ] ")" ;
call_arg        = expr | IDENTIFIER ":" expr ;   (* named args: Point(x: 3) *)
index_suffix    = "[" index_body "]" ;
index_body      = expr
                | [ expr ] ":" [ expr ] [ ":" [ expr ] ] ;   (* slicing *)
member_suffix   = ( "." | ".?." ) , IDENTIFIER ;
try_suffix      = "?" ;                          (* error propagation      *)

primary_expr    = atom ;
atom            = literal
                | INTERP_STRING
                | IDENTIFIER
                | "(" [ expr_list ] ")"          (* grouping / tuple       *)
                | list_display
                | map_display
                | set_display
                | lambda_expr
                | "unsafe" block                 (* unsafe as expr  [PROV.] *)
                | "new" type [ call_suffix ]
                | "self" | "Self"
                ;

call_arg_list   = call_arg , { "," , call_arg } [ "," ] ;

list_display    = "[" [ expr_list ] "]"
                | "[" expr "for" pattern "in" expr { comp_clause } "]"  (* listcomp [PROVISIONAL] *)
map_display     = "{" [ map_entry , { "," , map_entry } ] "}" ;
map_entry       = expr ":" expr ;
set_display     = "{" expr_list "}" ;


(* ---- Patterns (match / case / for-targets) ---------------------------------------- *)

pattern         = or_pattern ;
or_pattern      = ctor_pat , { "|" , ctor_pat } ;   (* p1 | p2 alternation *)
ctor_pat        = ref_pat | IDENTIFIER , "(" [ pat_field , { "," , pat_field } ] ")"
                | slice_pat | alias_pat | tuple_pat | range_pat | literal_pat
                | binding_pat | wildcard | group_pat ;
ref_pat         = "&" , pattern ;                (* ref pattern: `case &Point` *)
alias_pat       = binding_pat , "@" , sub_pattern ;
(* Rust-style `name @ sub-pattern`: binds the whole subject to `name` while
   matching the sub-pattern (e.g. `case n @ 1..=5 {`, `case t @ (a, b) {`). *)
sub_pattern     = ctor_pat | tuple_pat | range_pat | literal_pat
                | wildcard | group_pat ;            (* no bare binding on RHS *)
slice_pat       = "[" [ pat_item , { "," , pat_item } ]
                  [ rest_pat ] "]" ;
tuple_pat       = "(" [ pat_item , { "," , pat_item } ]
                  [ rest_pat ] ")" ;
pat_item        = pattern | rest_pat ;
rest_pat        = ".." [ IDENTIFIER ] ;            (* Rust `..` / `..rest` *)
(* Slice/tuple rest: `case [a, b, ..rest] {`, `case (first, ..tail) {`.
   `..` itself (unnamed) matches zero-or-more trailing elements.        *)

wildcard        = "_" ;
group_pat       = "(" pattern ")" ;
literal_pat     = [ "-" ] , ( INT_LITERAL | FLOAT_LITERAL )
                | STRING_LITERAL | CHAR_LITERAL | "true" | "false" | "none" ;
range_pat       = [ "-" ] number_lit , ( ".." | "..=" ) , [ "-" ] number_lit ;
number_lit      = INT_LITERAL | FLOAT_LITERAL ;

pat_field       = IDENTIFIER ":" pattern        (* named:  Point(x: 0, y)   *)
                | pattern ;                     (* positional: Circle(r)    *)

binding_pat     = [ "var" ] , IDENTIFIER , [ "is" type ] ;
(* Bare `case n:` = irrefutable binding. Exhaustiveness checking applies
   when every arm is refutable except a final wildcard/binding.             *)


(* ---- Types --------------------------------------------------------------------------- *)

type            = fn_type | prefixed_type ;
fn_type         = "fn" "(" [ type_list ] ")" [ "->" type ] ;
type_list       = type , { "," , type } ;

prefixed_type   = { type_prefix } , base_type , { type_postfix } ;
type_prefix     = "*"                 (* raw pointer  — unsafe contexts     *)
                | "&" [ "mut" ]       (* borrowed reference                 *)
                ;
base_type       = PRIMITIVE_TYPE_NAME
                | IDENTIFIER [ "[" type_list "]" ]     (* list[int], Pair[A,B], box[T] *)
                | "(" type , "," , type , ")"          (* tuple type *)
                | "(" ")"                              (* unit/none-as-type *)
                ;
type_postfix    = "?" ;               (* option sugar:  int? == option[int]  *)


# =============================================================================
# §4 RESOLVED NOTES (freeze record)
# =============================================================================
# 1. Keywords are canonical per §1 (mirrors the lexer); `go` REMOVED from
#    consideration (`spawn` covers it). Primitive type names are prelude
#    identifiers, not reserved words, keeping them shadowable in exotic
#    numeric libraries; container/view names (list, gen, result, option/?, any)
#    resolve in the checker the same way.
# 2. Blocks are brace-delimited `{ ... }`; simple statements end with `;`.
#    Newlines and indentation are insignificant (layout-free, C/Go/Rust style).
#    `elif` is accepted as a legacy alias for `else if`.
# 3. Assignment is a STATEMENT, not an expression (kills `if x = y:` bugs).
#    Multiple assignment / swap supported via tuple targets: a, b = b, a.
# 4. Comparison chaining adopts Python semantics (see §2 level 7).
# 5. Integer overflow: checked in debug builds, wrapping in release unless the
#    operation carries @checked — FINAL DECISION pending RFC (OQ #1).
# 6. `?` postfix desugars in the parser to `try <expr>` early-return form;
#    both spellings are interchangeable at every call position.
# 7. Named call arguments use `name:` value (colon), mirroring struct
#    construction; positional-after-named is a compile error.
# 8. `;` terminates every simple statement (imports, consts, assignments,
#    returns, expressions). Empty statement `;` is permitted but discouraged;
#    fmt removes it.
# 9. Everything not listed here is intentionally NOT in v1: no ternary `?:`,
#    no increment/decrement ++/--, no implicit bool→int, no goto.
# 10. Anonymous functions are single-expression lambdas ONLY (`(x) => e`).
#     Multi-statement closures bind a nested named `def`.
# 11. `pass` keyword covers empty blocks. `del` is implemented (bindings, dict
#     keys, list indexes, struct fields); `local`/`global` strict scoping;
#     `temp n N: T = v` compile-time use budgets; `bucket` park/release
#     namespace (see statements above).
# 12. Struct fields accept optional leading `var` (mutable field) / `weak`.
# 13. C-string literal `c"…"` added for FFI (NUL-terminated UTF-8).
# 14. `<-expr` receive operator valid ONLY inside select arms (chan_op).
# 15. Pattern features extended (Rust-style): or-patterns `p1 | p2`,
#     bindings-as-aliases `name @ sub-pattern`, and slice/tuple rest `..rest`.
#     `@` is parsed as a pattern-only operator (never a binary expression op).
# 16. Loops may be labeled: `label: while ... ` / `label: for ...`. `break l;`
#     and `continue l;` exit/skip that labeled loop from nested bodies
#     (Go/Rust loop-label style). Unlabeled `break`/`continue` act on the
#     innermost loop as before.
# 17. `bucket` is a RESERVED WORD (ratified by decision; it is NOT usable as
#     an identifier, hence the example-14 helper rename to `hash_bucket`).
# 18. A `def` whose own body contains a `yield` is a GENERATOR FUNCTION: the
#     call evaluates to a gen[T] (declared `-> gen[T]`, or inferred when the
#     `->` type is omitted). `return value;` inside a generator is rejected;
#     bare `return;` / falling off the end ends generation. Nested function
#     bodies do not inherit the generator context (their own yields mark them).
# 19. `yield` is CONTEXTUAL — reserved only at statement start (yield_stmt)
#     and inside comprehension forms (§2 level 1); it remains a valid
#     identifier elsewhere.
# 20. `temp`, `local`, `global`, `pr` are reserved words, each acting ONLY in
#     statement position; a `pr` (module-private) modifier is a prefix on
#     declarations (visibility guard, enforced at the module-export milestone).
# 21. Phase 5.1 — DEFAULT TYPE PARAMETERS: `def f[T = D]` declares D as the
#     fallback type for T. It is a static error to name a non-type in D. The
#     default substitutes ONLY where a call leaves T unconstrained (constraint
#     unification wins). Substitution rebuilds the nominal node; it never
#     mutates the function's declared signature. Generics without defaults keep
#     plain inference TypeVar semantics.
# 22. Phase 5.3 — ENUM DISCRIMINANTS & to_int(): variants enumerate in
#     declaration order; the i-th variant has discriminant i. `enum_val.to_int()`
#     (§2 postfix member + call) yields the discriminant and is typed `int`
#     (unlike string `.to_int()`, which returns `int?`). Payload-carrying
#     variants are counted too (their unit positions still enumerate).
# 23. Phase 5.4 — MATCH EXHAUSTIVENESS (safety default): enum matches must cover
#     every variant (a `case _` wildcard satisfies this); integer/char matches
#     must end in a `case _` arm. Violations are ERRORS, not warnings.
# 24. Phase 5.5 — BORROW ESCAPE (conservative): an address-of-local `&x` may not
#     escape the frame — returned, passed as a call argument, or stored into a
#     member/index/container target (a store into a plain local variable stays
#     in scope and is allowed). Violations are E-BORROW-ESCAPE errors.
# 25. OOP FACADE (desugars to the struct/trait/impl model; examples/36,37):
#     - `class Name implements I1, I2 { fields; methods }` → struct + inherent
#       impl + `impl I1 for Name`, `impl I2 for Name`.
#     - `class Derived extends Base { ... }` → single inheritance: inherits
#       Base's fields and non-overridden methods; redefining a method overrides
#       it VIRTUALLY (dispatch through a Base-typed reference hits the derived
#       version).
#     - `interface I { def m(self) -> T; }` → trait (Go-style structural bound).
#     - `record Name(f: T, ...) { }` → immutable field tuple (value type) with
#       structural `==` over its fields.
#     - `fn` is a full alias for `def` in declaration position.
# 26. TRY/RAISE/CATCH exceptions (examples/35): `try { } catch e { }` runs a
#     block and, if `raise(v)` fires inside, jumps to the catch block binding
#     `e` to `v`. `catch { }` (no binding) discards the value; a `try` without
#     `catch` re-raises. This is DISTINCT from `try call(...)` /
#     `call(...)?` error PROPAGATION on result[T,E] (see §2 level 17 and note
#     6). "catchable" here means a raised value, not a result error.
# 27. `match` is usable BOTH as a statement (match_stmt) and, when its value
#     flows up to an expression position, as an EXPRESSION (match_expr,
#     examples/38) whose arms are statement blocks that yield a value. Patterns
#     additionally support ref patterns `&pat` (transparent deref, `case &Point`).
# =============================================================================

EOF_MARKER      = end_of_file ;
