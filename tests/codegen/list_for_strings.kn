# M11: native iteration and comprehension over string lists.
fn join_items(items: list[Str]) -> Str {
    out = "";
    for item in items {
        if out != "" {
            out = out + ",";
        }
        out = out + item;
    }
    return out;
}

fn keep_items(items: list[Str]) -> list[Str] {
    return [item for item in items if item != ""];
}

fn main() -> none {
    print(join_items(["a", "b", "c"]));
    print(keep_items(["a", "", "c"]));
}
