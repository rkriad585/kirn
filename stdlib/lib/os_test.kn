# stdlib/lib/os_test.kn - tests for lib.os.
import lib.os;

def main() {
    args = os.args();
    # The runner always passes at least the program path; validate list type by
    # checking len() and that each element is a string.
    assert(args.len() >= 1);
    first = str(args[0]);
    assert(first.len() > 0);

    # getenv: our own environment variable is not set -> nil.
    g = os.getenv("COCO_OS_TEST_NOT_SET");
    assert(g == nil);

    print("os_test ok");
}