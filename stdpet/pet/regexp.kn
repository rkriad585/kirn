# stdlib/pet/regexp.kn - real regular expressions backed by the interpreter.
# The public API is Kirn; the private substrate supplies std::regex semantics.
pub fn match(pat: Str, s: Str) -> Bool {
    return __regex_match(pat, s);
}

pub fn find(s: Str, pat: Str) -> Int {
    return __regex_find(pat, s);
}

pub fn contains(s: Str, pat: Str) -> Bool {
    return __regex_find(pat, s) >= 0;
}

pub fn replace(s: Str, pat: Str, to: Str) -> Str {
    return __regex_replace(pat, s, to);
}

pub fn split(s: Str, pat: Str) -> list {
    return __regex_split(pat, s);
}
