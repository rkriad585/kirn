# stdlib/lib/regexp_test.kn - tests for lib.regexp.
import lib.regexp;

def main() {
    assert(regexp.match("a*b", "ab"));
    assert(regexp.match("a*b", "aaab"));
    assert(not regexp.match("a*b", "acb"));
    assert(regexp.match("a?c", "abc"));
    assert(not regexp.match("a?c", "ac"));
    assert(regexp.match("hello", "hello"));
    assert_eq(regexp.find("hello world", "world"), 6);
    assert_eq(regexp.find("hello", "zz"), -1);
    assert(regexp.contains("hello world", "lo wo"));
    assert_eq(regexp.replace("banana", "a", "o"), "bonono");

    print("regexp_test ok");
}