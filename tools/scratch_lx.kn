var global_count = 0;

fn mutate_list() -> none {
    var st = [0, "abc"];
    fn bump() -> none {
        st[0] = st[0] + 1;
        st[1] = st[1] + "x";
    }
    bump();
    bump();
    global_count += 1;
    return st;
}

fn read_dict() -> none {
    var d = {"k": 41};
    fn bump() -> none {
        d["k"] = d["k"] + 1;
    }
    bump();
    return d["k"];
}

fn main() -> none {
    print(mutate_list());
    print(read_dict());
    print("xxxxx"[1..4]);
    print("xxxxx"[-3..-1]);
    print(Ord('A'), Chr(67));
    c = "Hello"[0];
    print(c, Ord(c), c == 'H', c != 'h', c >= 'A', 'a' < 'b', '0' <= c, c <= 'Z');
    print("a" + "b" + "c");
    print(global_count);
}