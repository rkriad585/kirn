# 40 — memory & scoping keywords   (new data types / control / storage set)
# `None` type, `del` (vars + dict keys + list indexes + struct fields),
# `pr` private declarations, `local` / `global` strict scoping, `temp`
# compile-time use budgets, and the `bucket` park/release namespace.

pr fn secret() -> Str { return "hidden"; }   # private — explicit module-local

var counter = 0;                                  # module-top-level global

class Gadget { var label: Str = ""; var n: Int = 0; }

fn bump(by) -> none {
    global counter;
    counter = counter + by;
}

fn main() -> none {
    # ---- None type
    var nada: None = none;
    print("None=" + Str(nada));

    # ---- del: variables, dict keys, list indexes, struct fields
    x = 42;
    del x;
    d = {"a": 1, "b": 2, "c": 3};
    del d["b"];
    print("dict=" + Str(d));
    xs = [1, 2, 3, 4];
    del xs[2];
    print("list=" + Str(xs));
    g = Gadget(label: "hi", n: 3);
    print("before=" + g.label);
    del g.label;                                      # removes instance field
    print("gadget-n-after-del=" + Str(g.n));

    # ---- pr & global
    print("pr=" + secret());                      # private fn callable in-module
    bump(5);
    bump(7);
    print("counter=" + Str(counter));

    # ---- local (strict: same-scope re-decl is a compile error)
    local count = 1;
    print("local=" + Str(count));

    # ---- temp (compile-time use budget; use #(N+1) is a compile error)
    temp scratch 3: Int = 100;
    print("t1=" + Str(scratch));
    print("t2=" + Str(scratch + 1));
    print("t3=" + Str(scratch));

    # ---- bucket (separate namespace: park / release)
    bucket heavy = [1, 2, 3, 4, 5];                # offloaded, invisible to lookup
    bucket release heavy;                          # bring it back
    print("bucket=" + Str(heavy));
}