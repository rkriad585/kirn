# Macros supplied entirely from the command line, so that -D and -U are
# observable. Nothing here defines FEATURE or GONE: a -D that a file then
# redefines would be masked by the file's own {.fn.}, which is the documented
# precedence (the command line seeds the table, the file may override it).
fn main() -> none {
  {.ifdef FEATURE.}
  print("feature on");
  {.else.}
  print("feature off");
  {.endif.}
  {.ifdef GONE.}
  print("gone on");
  {.endif.}
}
