# comprehensions_ok — M3: list/set/dict comprehensions (PEP 202/274).
# Positive: warning-free, tree-walker and VM must agree (gate 2b).
fn main() -> none {
    squares = [x * x for x in 0..5];
    print(squares);                         # [0, 1, 4, 9, 16]

    evens = [x for x in 0..10 if x % 2 == 0];
    print(evens);                           # [0, 2, 4, 6, 8]

    pairs = [(x, y) for x in 0..3 for y in 0..2];
    print(pairs);                           # [(0, 0), (0, 1), (1, 0), (1, 1), (2, 0), (2, 1)]

    kinds = {x % 3 for x in 0..10};
    print(kinds);                           # {0, 1, 2}

    table = {k: k * k for k in 0..4};
    print(table);                           # {0: 0, 1: 1, 2: 4, 3: 9}
}
