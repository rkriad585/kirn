fn main() -> none {
    print(Ord('\u{0}'));
    print(Ord('\\'), Ord('\''), Ord('"'), Ord('{'), Ord('}'));
    print(Ord('\n'), Ord('\r'), Ord('\t'), Ord(' '), Ord('.'));
    print(Ord('x'), Ord('e'), Ord('E'), Ord('+'), Ord('-'));
    print(Ord('0'), Ord('9'), Ord('a'), Ord('z'), Ord('A'), Ord('Z'), Ord('_'));
    s = "a\tb";
    print(s, len(s));
}