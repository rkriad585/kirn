# Conditional compilation gating real code inside a function: ifdef / ifndef /
# else / endif and nesting. A dead branch is never even emitted -- the -E dump
# shows its text absent, not blanked -- so an undefined name inside one cannot
# reach the checker. The guarded use of DEEP below is what makes that visible:
# with FEATURE_A undefined, DEEP is never defined and never referenced.
{.ifdef FEATURE_A.}
{.fn LABEL. "A on".}
{.else.}
{.fn LABEL. "A off".}
{.endif.}
{.ifndef FEATURE_B.}
{.fn OTHER. "B off".}
{.endif.}
{.if 1 + 1 == 2.}
{.fn MATH. "math works".}
{.else.}
{.fn MATH. "math broken".}
{.endif.}
{.ifdef FEATURE_A.}
{.ifdef NESTED.}
{.fn DEEP. "nested on".}
{.else.}
{.fn DEEP. "nested off".}
{.endif.}
{.endif.}
fn main() -> none {
  print(LABEL);
  print(OTHER);
  print(MATH);
  {.ifdef FEATURE_A.}
  print(DEEP);
  {.endif.}
}
