# stdlib/pet/collections.kn - data-structure utilities (Kirn-written, Phase 6).
# Provides a HashMap struct plus functional list helpers. Import with:
#   import pet.collections;

# A string-keyed hash map over a runtime dict. The dict type keys are coerced
# to strings so int/str keys unify; lookups are O(1) amortized.
pub struct HashMap {
    var buckets: dict;
    fn put(self, k, v) -> none {
        self.buckets[Str(k)] = v;
    }
    fn get(self, k) -> none {
        d = self.buckets;
        return d[Str(k)];
    }
    fn has(self, k) -> Bool {
        d = self.buckets;
        return Str(k) in d;
    }
    fn remove(self, k) -> none {
        d = self.buckets;
        key = Str(k);
        if key in d {
            d.remove(key);
        }
    }
    fn size(self) -> Int {
        return self.buckets.len();
    }
}

# Split a string on a separator into a list of parts ("" -> empty when empty).
pub fn split(s: Str, sep: Str) -> list {
    if s == "" { return []; }
    return s.split(sep);
}

# Join a list of values with sep. Note the argument order differs from the
# low-level `join` builtin (sep, xs) - this is (parts, sep) for readability.
pub fn join(parts: list, sep: Str) -> Str {
    if parts.len() == 0 { return ""; }
    out = Str(parts[0]);
    i = 1;
    while i < parts.len() {
        out = out + sep + Str(parts[i]);
        i = i + 1;
    }
    return out;
}

# True if xs contains an element equal to value.
pub fn contains(xs: list, value) -> Bool {
    for x in xs {
        if x == value { return true; }
    }
    return false;
}

# Return a new list of unique elements (first-occurrence order preserved).
pub fn unique(xs: list) -> list {
    seen = {};
    out = [];
    for x in xs {
        if not (Str(x) in seen) {
            seen[Str(x)] = true;
            out.append(x);
        }
    }
    return out;
}

# Fisher-Yates shuffle of a copy.
pub fn shuffle(xs: list) -> list {
    out = [] + xs;
    i = out.len() - 1;
    while i > 0 {
        j = Int(rand_float() * Float(i + 1));
        if j > i { j = i; }
        tmp = out[i];
        out[i] = out[j];
        out[j] = tmp;
        i = i - 1;
    }
    return out;
}

pub fn rand_float() -> Float {
    return Float(time.now() % 100000) / 100000.0;
}