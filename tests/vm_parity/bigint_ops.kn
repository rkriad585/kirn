fn main() -> none {
    # full Knuth-D division with multi-limb divisors (Python semantics)
    a = BigInt("123456789012345678901234567890");
    print(a // BigInt("9876543210987654321"));      # 12499999886
    print(a % BigInt("9876543210987654321"));       # 925925941327160484
    print(a // BigInt(-7));                         # -17636684144620811271604938270
    print(a % BigInt(-7));                          # 0

    # Karatsuba multiply (>= 32 limbs) is exact and commutative
    x = BigInt(2).pow(2000) + BigInt(123456789);
    y = BigInt(2).pow(1999) + BigInt(987654321);
    print(x * y == y * x);                           # true
    print((x * y).bit_length());                     # 4000

    # gcd / lcm / modular inverse / modular square root
    print(BigInt(48).gcd(BigInt(36)));             # 12
    print(BigInt(48).lcm(BigInt(36)));             # 144
    print(BigInt(3).mod_inverse(11));               # 4
    print(BigInt(3).mod_inverse(4));                # 3
    print(BigInt(4).mod_sqrt(13));                  # 11 (a root)
    print(BigInt(2).mod_sqrt(7));                   # 4   (7 ≡ 3 mod 4)

    # bit ops (infinite two's complement, Python/Ruby semantics)
    print(BigInt(-6) & BigInt(3));                 # 2
    print(BigInt(-6) | BigInt(3));                 # -5
    print(BigInt(-6) ^ BigInt(3));                 # -7
    print(BigInt(5) << 100);                        # 6338253001141147007483516026880
    print(BigInt(2).pow(100) >> 99);                # 2
    print(BigInt(-7) >> 1);                         # -4 (floor)

    # Miller-Rabin primality (multi-limb)
    print(BigInt("170141183460469231731687303715884105727").is_prime());   # true  (2^127-1)
    print(BigInt("170141183460469231731687303715884105725").is_prime());   # false
    print(BigInt(1000000007).is_prime());           # true

    # conversions
    print(Str(BigInt(-255), 16));                   # -ff
    print(ToBytes(258, 2));                         # b'\x02\x01'
    print(ToBytes(258, 2, "big"));                  # b'\x01\x02'
    print(FromBytes(BigInt(-1).to_bytes(4)));      # -1
    print(BigInt(1000).to_float());                 # 1000.0

    # floor division agrees with int arithmetic across a signed range
    for i in range(-25, 25) {
        assert_eq((BigInt(i) // BigInt(7)).to_int(), i // 7);
        assert_eq((BigInt(i) % BigInt(7)).to_int(), i % 7);
    }
    print("ok");
}
