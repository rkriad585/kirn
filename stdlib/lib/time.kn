# stdlib/lib/time.kn - time utilities (Coco-written, Phase 6).
# Built on the runtime `time` pseudo-module (now/sleep/after). Import with:
#   import lib.time;

# The pseudo-module is captured at load time (the module's own namespace is
# bound under the same name `time` in the consumer, which shadows it inside).
priv_now = time.now;
priv_ms = time.now;
priv_sleep = time.sleep;

# Seconds since epoch as float (millisecond precision from the substrate).
pub def now() -> float {
    return float(priv_now()) / 1000.0;
}

# Epoch milliseconds as int.
pub def now_ms() -> int {
    return priv_ms();
}

# Sleep for ms milliseconds (no-op in < 0).
pub def sleep(ms: int) {
    if ms < 0 { return; }
    priv_sleep(ms);
}

# Human-readable positive-integer ordinal suffix: 1st, 2nd, 3rd, 11th, 21st...
pub def ordinal(n: int) -> string {
    if n >= 11 and n <= 13 { return str(n) + "th"; }
    r = n % 10;
    if r == 1 { return str(n) + "st"; }
    if r == 2 { return str(n) + "nd"; }
    if r == 3 { return str(n) + "rd"; }
    return str(n) + "th";
}