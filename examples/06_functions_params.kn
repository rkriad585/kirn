# 06 — Functions: defaults, variadics, fn values, named args   (plan §5.5)
def add(a: int, b: int) -> int {
    return a + b;

}
def greet(name: string = "world") { # default parameter value
    print(f"hello {name}");

}
def sum_all(*nums: int) -> int { # variadic parameter
    total = 0;
    for n in nums {
        total += n;
}
    return total;

}
def apply(op: fn(int, int) -> int, a: int, b: int) -> int {
    return op(a, b); # functions are first-class values

}
def main() {
    greet();
    greet(name: "Coco"); # named argument (colon syntax)
    print(add(2, 3), sum_all(1, 2, 3, 4));
    print(apply(op: add, a: 10, b: 20));
}
