# M11: native nominal struct construction and Value-valued returns.
struct Point {
    x: Int;
    label: Str;
}

fn make_point() -> Point {
    return Point(x: 3, label: "created");
}

fn make_optional() -> Point? {
    return Point(x: 5, label: "optional");
}

fn main() -> none {
    print(make_point());
    print(make_optional());
}
