import pet.yaml as yaml;
import reflect;

struct Point { x: Int; y: Int; }
struct User { name: Str; age: Int; home: Point; tags: list[Str]; pi: Float; live: Bool; note: none; }
enum Shape { Circle(r: Float); Rect(w: Float, h: Float); Empty; }
struct Bag { items: list[Shape]; }

fn main() -> none {
    # Block mappings, nested by indentation; comments stripped.
    t = yaml.loads("# lead\nname: Kirn # trail\nversion: 3\npi: 3.5\ndebug: true\n");
    assert(t["name"] == "Kirn");
    assert(t["version"] == 3);
    assert(reflect.kind_of(t["version"]) == "int");
    assert(t["pi"] == 3.5);
    assert(t["debug"]);

    # Null forms: explicit, tilde, and key without value.
    n = yaml.loads("a: null\nb: ~\nc:\n");
    assert(n["a"] == none and n["b"] == none and n["c"] == none);

    # Sequences of plain scalars, incl. spaces and quoted forms.
    s = yaml.loads("tags:\n  - a\n  - b two\n  - \"x\\ty\"\n  - 'it''s'\n");
    assert(s["tags"].len() == 4);
    assert(s["tags"][1] == "b two");
    assert(s["tags"][2] == "x\ty");
    assert(s["tags"][3] == "it's");

    # Nested mappings and a mapping inside a sequence item.
    d = yaml.loads("db:\n  hosts:\n    - name: h1\n      port: 80\n    - name: h2\n      port: 443\n");
    assert(d["db"]["hosts"][1]["name"] == "h2");
    assert(d["db"]["hosts"][0]["port"] == 80);

    # Flow collections.
    f = yaml.loads("f: {a: 1, b: [2, 3]}\n");
    assert(f["f"]["a"] == 1);
    assert(f["f"]["b"][1] == 3);

    # Sequence of sequences (dash on the same line).
    l = yaml.loads("l:\n  - - 1\n    - 2\n  - - 3\n");
    assert(l["l"][0][1] == 2);
    assert(l["l"][1][0] == 3);

    # Numbers: sign, underscores, exponents, inf.
    nums = yaml.loads("i: -42\nu: 1_000\ne: 1.5e2\ninfv: .inf\nninf: -.inf\n");
    assert(nums["i"] == -42);
    assert(nums["u"] == 1000);
    assert(nums["e"] == 150.0);
    assert(Str(nums["infv"]) == "inf");
    assert(Str(nums["ninf"]) == "-inf");

    # Empty containers.
    e = yaml.loads("m: {}\nl: []\n");
    assert(e["m"].len() == 0 and e["l"].len() == 0);

    # # inside quotes is not a comment; plain commas survive.
    c = yaml.loads("note: a \"b# c\" d\nmsg: Kirn, the lang\n");
    assert(c["note"] == "a \"b# c\" d");
    assert(c["msg"] == "Kirn, the lang");

    # Render -> parse round-trip preserves types and nesting.
    back = yaml.loads(yaml.dumps(t));
    assert(back["name"] == "Kirn" and back["version"] == 3 and back["pi"] == 3.5);
    back2 = yaml.loads(yaml.dumps(d));
    assert(back2["db"]["hosts"][1]["port"] == 443);

    # Strings that look like numbers stay strings after a round-trip.
    sn = yaml.loads("q: \"42\"\np: 42\n");
    sq = yaml.loads(yaml.dumps(sn));
    assert(sq["q"] == "42" and sq["p"] == 42);

    # to_string/from_string rebuild structs (nested + list + enum).
    u = User(name: "ada", age: 36, home: Point(x: 1, y: 2),
             tags: ["a", "b"], pi: 3.5, live: true, note: none);
    ub = yaml.from_string(User, yaml.to_string(u));
    assert(ub.name == "ada" and ub.age == 36);
    assert(ub.home.x == 1 and ub.home.y == 2);
    assert(ub.tags.len() == 2 and ub.tags[1] == "b");
    assert(ub.pi == 3.5 and ub.live and ub.note == none);

    # Enums: externally tagged payload lists.
    sh = yaml.from_string(Shape, "Rect:\n  - 2.0\n  - 3.0\n");
    assert(reflect.variant(sh) == "Rect");
    assert(reflect.payload(sh)[0] == 2.0 and reflect.payload(sh)[1] == 3.0);
    bag = yaml.from_string(Bag, yaml.to_string(Bag(items: [Shape.Circle(r: 1.5), Shape.Rect(w: 1.0, h: 2.0)])));
    assert(reflect.variant(bag.items[0]) == "Circle");
    assert(reflect.payload(bag.items[0])[0] == 1.5);
    assert(reflect.variant(bag.items[1]) == "Rect");

    # Empty documents parse to empty tables.
    assert(yaml.loads("").len() == 0);
    assert(yaml.loads("# only a comment\n").len() == 0);

    print("yaml_test ok");
}
