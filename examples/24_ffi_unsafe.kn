# 24 — FFI & unsafe                       (plan §9)
extern fn printf(fmt: *Char, ...) -> i32; # C library symbol, linked at build
extern fn strlen(s: *Char) -> usize;

fn print_message(msg: Str) -> none { # safe wrapper around unsafe core
    unsafe {
        printf(c"%s (len=%zu)\n", msg.c_ptr(), strlen(msg.c_ptr()));

}
}
fn main() -> none {
    # raw pointers may only be TOUCHED inside `unsafe:` blocks:
    msg = "Hello from Kirn!";
    unsafe {
        printf(c"%s!\n", msg.c_ptr());
}
    print_message(msg);
}
